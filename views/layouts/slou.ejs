        }

        frame.addEventListener('click', function (e) {
          if (onControl(e) || clickHold) { return; }
          clickHold = setTimeout(function () {
            clickHold = null;
            if (v.paused) { start(v); } else { v.pause(); }
          }, 230);
        });

        frame.addEventListener('dblclick', function (e) {
          if (onControl(e)) { return; }

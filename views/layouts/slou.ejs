        document.addEventListener(evt, function () {
          var active = fullscreenEl();
          players.forEach(function (v) {
            var f = frameOf(v);
            if (f) { f.classList.toggle('is-full', f === active); }
          });
        });
      });

      // Sound toggle — clips play with sound, this mutes an individual one.
      document.querySelectorAll('.vsound').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();

        // Jump straight to the clicked photo, without sliding past the others.
        track.classList.add('is-dragging');
        go(index);
        dlg.showModal();
        requestAnimationFrame(function () { track.classList.remove('is-dragging'); });
      }

      // Clip and photos share one numbering per product: the clip is 0, so
      // a photo's position is its own index plus one when there is a clip.
      function hasClip(group) { return !!document.querySelector('.xcard__video[data-group="' + group + '"]'); }
      [].slice.call(document.querySelectorAll('.xthumb')).forEach(function (b) {
        b.addEventListener('click', function () {
          open(b.dataset.group, (parseInt(b.dataset.index, 10) || 0) + (hasClip(b.dataset.group) ? 1 : 0));
        });
      });
      [].slice.call(document.querySelectorAll('.xcard__video, .xcard__expand')).forEach(function (el) {
        el.addEventListener('click', function () { open(el.dataset.group, 0); });
      });
      // Only the slide on screen plays; closing stops them all.
      function playCurrent() {
        [].slice.call(track.querySelectorAll('video')).forEach(function (v, n) {
          var slideIndex = [].indexOf.call(track.children, v.parentNode);
          if (slideIndex === at) { var p = v.play(); if (p && p.catch) { p.catch(function () {}); } } else { v.pause(); }
        });
      }
      track.addEventListener('transitionend', playCurrent);
      dlg.addEventListener('close', function () {
        [].slice.call(track.querySelectorAll('video')).forEach(function (v) { v.pause(); });
      });
      prev.addEventListener('click', function () { go(at - 1); });
      next.addEventListener('click', function () { go(at + 1); });
      dlg.querySelector('.xlight__close').addEventListener('click', function () { dlg.close(); });
      dlg.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(at - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); go(at + 1); }
      });
      // A click on the dark area around a photo closes; a click on the photo
      // itself does not.
      stage.addEventListener('click', function (e) {
        if (!moved && e.target.classList.contains('xslide')) { dlg.close(); }
      });

      // Swipe: the track follows the finger, then settles on the nearest
      // photo. A short flick is enough; a drag of under 10px counts as a tap.
      var startX = null, dx = 0, moved = false;
      stage.addEventListener('pointerdown', function (e) {
        if (e.target.closest('button') || total < 2) { return; }
        startX = e.clientX; dx = 0; moved = false;
        track.classList.add('is-dragging');
      });
      window.addEventListener('pointermove', function (e) {
        if (startX === null) { return; }
        dx = e.clientX - startX;
        if (Math.abs(dx) > 10) { moved = true; }
        track.style.transform = 'translateX(calc(' + (-at * 100) + '% + ' + dx + 'px))';
      });
      function endDrag() {
        if (startX === null) { return; }
        startX = null;
        track.classList.remove('is-dragging');
        var limit = Math.min(80, stage.clientWidth * 0.15);
        if (dx < -limit) { go(at + 1); } else if (dx > limit) { go(at - 1); } else { go(at); }
        setTimeout(function () { moved = false; }, 0);
      }
      window.addEventListener('pointerup', endDrag);
      window.addEventListener('pointercancel', endDrag);
    })();

    // ---- Christmas sky ----
    // Drawn on the canvas behind the offer, and only there. Four things,
    // mixed at random so the band never looks the same twice:
    //   stars     always there, many, small, in five colours, each
    //             twinkling at its own pace; random ones flash briefly.
    //             (drawStar can also draw large turning sparkles for stars
    //             with `glint` set; none are made at present.)
    //   snow      comes in spells: a random intensity for 8-20 s, mostly
    //             moderate to heavy, now and then none
    //   shooting  a star with a tail every few seconds, falling across
    //   wind      gusts that push the snow sideways and draw faint streaks
    //   blizzard  rare, only while snowing: a strong wind drives thick snow
    //             sideways in streaks for a few seconds
    // Runs only while the band is on screen and the tab is visible; reduced
    // motion gets one still frame of stars and nothing moving.
    (function () {
      var canvas = document.querySelector('.xmas__sky');
      if (!canvas || !canvas.getContext) { return; }
      var band = canvas.parentNode;
      var ctx = canvas.getContext('2d');
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var W = 0, H = 0, dpr = 1;
      var stars = [], flakes = [], shooters = [], streaks = [];
      var snow = 0, snowTarget = 0, nextSnowChange = 0;
      var wind = 0, windTarget = 0, gustEnds = 0, nextGust = 0;
      var blizzard = false, nextBlizzard = 0, snowBeforeBlizzard = 0;
      var nextShooter = 0;
      var running = false, onScreen = false, last = 0;

      function rand(a, b) { return a + Math.random() * (b - a); }

      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = band.clientWidth; H = band.clientHeight;
        canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        // About one star per 1600 px², so a phone gets fewer than a desktop.
        // All small: most are specks, the rest slightly larger with a faint glow.
        var count = Math.round(W * H / 1600);
        stars = [];
        for (var i = 0; i < count; i++) {
          var roll = Math.random();
          var size = roll < 0.65 ? rand(0.4, 0.8) : rand(0.8, 1.3);
          stars.push({
            x: Math.random() * W, y: Math.random() * H,
            r: size,
            color: pickColor(),
            base: rand(0.45, 0.9),
            depth: rand(0.15, 0.55),          // how far the twinkle dips
            speed: rand(0.3, 3.2),            // slow and deep, or fast and nervous
            phase: Math.random() * Math.PI * 2,
            glint: false,                     // sparkles off: small stars only
            spin: rand(-0.25, 0.25),
            flash: 0,
          });
        }
        if (still) { draw(0, 0); }
      }

      // Star colours, as rgb triples: mostly white, then warm gold, icy
      // blue, soft rose and pale mint, in that order of likelihood.
      var COLORS = [
        [255, 252, 240], [255, 252, 240], [255, 252, 240], [255, 252, 240],
        [255, 222, 150], [255, 214, 120], [190, 220, 255], [170, 205, 255],
        [255, 200, 215], [205, 255, 225],
      ];
      function pickColor() { return COLORS[Math.floor(Math.random() * COLORS.length)]; }

      // Sprites, drawn once per colour and stamped with drawImage (much
      // cheaper than gradients per star per frame):
      //   glow     a soft round glow, for the small and middle stars
      //   sparkle  a thick four-pointed star with curved, pinched sides, a
      //            white-hot core fading into the colour, on a soft glow;
      //            for the big stars
      var sprites = {};
      function sprite(kind, c) {
        var key = kind + c.join(',');
        if (sprites[key]) { return sprites[key]; }
        var S = 128, m = S / 2, rgb = c.join(',');
        var g = document.createElement('canvas');
        g.width = g.height = S;
        var x = g.getContext('2d');
        var glow = x.createRadialGradient(m, m, 0, m, m, m);
        glow.addColorStop(0, 'rgba(' + rgb + ',' + (kind === 'glow' ? 1 : .55) + ')');
        glow.addColorStop(kind === 'glow' ? 0.15 : 0.1, 'rgba(' + rgb + ',' + (kind === 'glow' ? .8 : .35) + ')');
        glow.addColorStop(0.4, 'rgba(' + rgb + ',.12)');
        glow.addColorStop(1, 'rgba(' + rgb + ',0)');
        x.fillStyle = glow;
        x.fillRect(0, 0, S, S);
        if (kind === 'sparkle') {
          // Four points joined by curves bowed in towards the centre.
          var tip = m * 0.95, waist = m * 0.13;
          x.beginPath();
          x.moveTo(m, m - tip);
          x.quadraticCurveTo(m + waist, m - waist, m + tip, m);
          x.quadraticCurveTo(m + waist, m + waist, m, m + tip);
          x.quadraticCurveTo(m - waist, m + waist, m - tip, m);
          x.quadraticCurveTo(m - waist, m - waist, m, m - tip);
          x.closePath();
          var core = x.createRadialGradient(m, m, 0, m, m, tip);
          core.addColorStop(0, 'rgba(255,255,255,1)');
          core.addColorStop(0.18, 'rgba(255,255,255,.95)');
          core.addColorStop(0.45, 'rgba(' + rgb + ',.85)');
          core.addColorStop(1, 'rgba(' + rgb + ',0)');
          x.fillStyle = core;
          x.fill();
        }
        return (sprites[key] = g);
      }

      function drawStar(s, t, f) {
        var tw = Math.sin(t * s.speed + s.phase);
        // A second, slower wave on top makes the twinkle less regular.
        var tw2 = Math.sin(t * s.speed * 0.37 + s.phase * 1.7);
        if (s.flash > 0) { s.flash = Math.max(0, s.flash - 0.02 * f); }
        var a = Math.min(1, Math.max(0, s.base + tw * s.depth + tw2 * 0.15 + s.flash));
        var c = s.color;
        if (s.r < 0.9 && s.flash === 0) {
          ctx.fillStyle = 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a + ')';
          ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2); ctx.fill();
          return;
        }
        var peak = Math.max(0, tw, s.flash);
        ctx.globalAlpha = a;
        if (s.glint) {
          ctx.globalAlpha = Math.min(1, a + 0.3);
          // Big stars: the sparkle swells at the top of its twinkle (and on a
          // flash) and turns slowly, each at its own speed.
          var size = s.r * (3.2 + 2.2 * peak + s.flash * 3);
          ctx.save();
          ctx.translate(s.x, s.y);
          ctx.rotate(s.phase + t * s.spin);
          ctx.drawImage(sprite('sparkle', c), -size, -size, size * 2, size * 2);
          ctx.restore();
        } else {
          var halo = s.r * (2.6 + 1.2 * peak + s.flash * 2.5);
          ctx.drawImage(sprite('glow', c), s.x - halo, s.y - halo, halo * 2, halo * 2);
        }
        ctx.globalAlpha = 1;
      }

      function weather(now) {
        // Snow spells: now and then a clear sky, mostly moderate to heavy.
        if (now > nextSnowChange) {
          snowTarget = Math.random() < 0.2 ? 0 : rand(0.7, 1.5);
          nextSnowChange = now + rand(8000, 20000);
        }
        snow += (snowTarget - snow) * 0.01;

        // Blizzard: rare, and only while it is already snowing. A strong wind
        // drives the snow sideways for a few seconds and the snow thickens,
        // then it all calms down and the ordinary weather carries on.
        if (!nextBlizzard) { nextBlizzard = now + rand(5000, 15000); }
        if (!blizzard && snow > 0.25 && now > nextBlizzard) {
          blizzard = true;
          windTarget = (Math.random() < 0.5 ? -1 : 1) * rand(5.5, 8.5);
          gustEnds = now + rand(3000, 6000);
          snowBeforeBlizzard = snowTarget;
          snowTarget = Math.min(2, snow + 0.8);
        }
        if (blizzard && now > gustEnds) {
          blizzard = false;
          windTarget = 0;
          snowTarget = snowBeforeBlizzard;
          nextGust = now + rand(5000, 12000);
          nextBlizzard = now + rand(10000, 25000);
        }

        // Gusts: a burst of wind one way or the other, then calm again.
        if (!blizzard && now > nextGust) {
          windTarget = (Math.random() < 0.5 ? -1 : 1) * rand(1.2, 3.2);
          gustEnds = now + rand(1800, 4200);
          nextGust = gustEnds + rand(5000, 14000);
        }
        if (!blizzard && now > gustEnds) { windTarget = 0; }
        // A blizzard builds up (and dies down) faster than a gust.
        wind += (windTarget - wind) * (blizzard ? 0.045 : 0.02);

        if (now > nextShooter) {
          var fromLeft = Math.random() < 0.5;
          shooters.push({
            x: fromLeft ? rand(-40, W * 0.5) : rand(W * 0.5, W + 40),
            y: rand(-20, H * 0.3),
            vx: (fromLeft ? 1 : -1) * rand(5, 8), vy: rand(2.2, 3.6),
            life: 0, max: rand(55, 85),
          });
          nextShooter = now + rand(3000, 9000);
        }
      }

      function draw(now, dt) {
        var t = now / 1000, f = dt / 16.67;   // f: frames' worth at 60 fps
        ctx.clearRect(0, 0, W, H);
        // Now and then a random star flares up for a moment.
        if (!still && stars.length && Math.random() < 0.04 * f) {
          stars[Math.floor(Math.random() * stars.length)].flash = rand(0.6, 1);
        }
        stars.forEach(function (s) { drawStar(s, t, f || 1); });
        if (still) { return; }

        // New flakes in proportion to the snow level; wind also feeds them in
        // from the side it blows from, so a gust does not empty the band.
        var spawn = snow * 2.6 * f;
        while (spawn > 0) {
          if (Math.random() < spawn) {
            // The stronger the wind, the more snow blows in from the side.
            var side = Math.abs(wind) > 1 && Math.random() < Math.min(0.7, 0.2 + Math.abs(wind) * 0.07);
            flakes.push({
              x: side ? (wind > 0 ? -5 : W + 5) : Math.random() * W,
              y: side ? Math.random() * H * 0.7 : -6,
              r: rand(0.8, 2.8), vy: rand(0.45, 1.3),
              sway: Math.random() * Math.PI * 2, drift: rand(0.4, 1.2),
            });
          }
          spawn -= 1;
        }
        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
        flakes = flakes.filter(function (p) {
          p.sway += 0.02 * f;
          p.x += (Math.sin(p.sway) * 0.35 + wind * p.drift) * f;
          p.y += p.vy * (1 + Math.abs(wind) * 0.15) * f;
          ctx.globalAlpha = Math.min(1, 0.4 + p.r / 3);
          if (Math.abs(wind) > 3) {
            // Strong wind: flakes smear into short streaks along their path.
            var vx = Math.sin(p.sway) * 0.35 + wind * p.drift, vy = p.vy * (1 + Math.abs(wind) * 0.15);
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.75)';
            ctx.lineWidth = p.r * 1.05; ctx.lineCap = 'round';
            ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p.x - vx * 2.2, p.y - vy * 2.2); ctx.stroke();
          } else {
            ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
          }
          return p.y < H + 6 && p.x > -20 && p.x < W + 20;
        });
        ctx.globalAlpha = 1;

        // Wind streaks: thin fading curves while a gust is strong.
        if (Math.abs(wind) > 1.2 && Math.random() < (blizzard ? 0.45 : 0.12) * f) {
          streaks.push({ x: wind > 0 ? rand(-120, W * 0.4) : rand(W * 0.6, W + 120),
                         y: rand(10, H - 10), len: rand(60, 160), life: 0, max: rand(40, 70) });
        }
        streaks = streaks.filter(function (w) {
          w.life += f;
          w.x += wind * 3.2 * f;
          var k = Math.sin(Math.PI * w.life / w.max);
          var dir = wind > 0 ? 1 : -1;
          ctx.strokeStyle = 'rgba(247, 241, 230,' + (0.16 * k) + ')';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(w.x, w.y);
          ctx.quadraticCurveTo(w.x + dir * w.len * 0.5, w.y - 6, w.x + dir * w.len, w.y + 2);
          ctx.stroke();
          return w.life < w.max;
        });

        // Shooting stars: a bright head with a tapering tail behind it.
        shooters = shooters.filter(function (s) {
          s.life += f;
          s.x += s.vx * f; s.y += s.vy * f;
          var k = Math.sin(Math.PI * Math.min(1, s.life / s.max));
          var tx = s.x - s.vx * 14, ty = s.y - s.vy * 14;
          var g = ctx.createLinearGradient(s.x, s.y, tx, ty);
          g.addColorStop(0, 'rgba(255, 248, 225,' + (0.95 * k) + ')');
          g.addColorStop(1, 'rgba(217, 184, 119, 0)');
          ctx.strokeStyle = g; ctx.lineWidth = 1.6; ctx.lineCap = 'round';
          ctx.beginPath(); ctx.moveTo(s.x, s.y); ctx.lineTo(tx, ty); ctx.stroke();
          ctx.fillStyle = 'rgba(255, 255, 255,' + k + ')';
          ctx.beginPath(); ctx.arc(s.x, s.y, 1.6, 0, Math.PI * 2); ctx.fill();
          return s.life < s.max;
        });
      }

      function frame(now) {
        if (!running) { return; }
        var dt = last ? Math.min(now - last, 50) : 16.67;
        last = now;
        weather(now);
        draw(now, dt);
        requestAnimationFrame(frame);
      }

      function update() {
        var should = !still && onScreen && document.visibilityState === 'visible';
        if (should && !running) { running = true; last = 0; requestAnimationFrame(frame); }
        if (!should) { running = false; }
      }

      resize();
      if ('ResizeObserver' in window) { new ResizeObserver(resize).observe(band); }
      else { window.addEventListener('resize', resize); }
      if (still) { return; }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (e) { onScreen = e[0].isIntersecting; update(); }).observe(band);
      } else { onScreen = true; }
      document.addEventListener('visibilitychange', update);
      update();
    })();

    // ---- Homepage conversation ----
    // The customer's thread with the shop. There are no accounts on the
    // server: placing an order returns { id, key }, which is kept here in
    // localStorage, and holding it is what lets this browser read the thread.
    // On every homepage visit the thread is fetched and shown at the top, so
    // a customer who comes back sees the reply without needing an email.
    //
    // Exposed as window.slouConv so the order form (below) can hand over a new
    // conversation and send the existing one along with a further order.
    (function () {
      var box = document.getElementById('conv');
      if (!box) { return; }
      var log = document.getElementById('convLog');
      var form = document.getElementById('convForm');
      var input = document.getElementById('cMsg');
      var btn = document.getElementById('cSubmit');
      var err = document.getElementById('cMsgErr');
      var d = box.dataset;
      var STORE = 'slou.conversation';

      // Wrapped: private windows and blocked site data make localStorage
      // throw, and that must cost the conversation box, not the page.
      function stored() {
        try {
          var v = JSON.parse(localStorage.getItem(STORE) || 'null');
          return (v && v.id && v.key) ? { id: v.id, key: v.key } : null;
        } catch (e) { return null; }
      }
      function remember(conv) {
        try { localStorage.setItem(STORE, JSON.stringify({ id: conv.id, key: conv.key })); } catch (e) {}
      }
      function forget() {
        try { localStorage.removeItem(STORE); } catch (e) {}
      }

      var when = (function () {
        try {
          var f = new Intl.DateTimeFormat(d.locale || undefined, { dateStyle: 'medium', timeStyle: 'short' });
          return function (iso) { return f.format(new Date(iso)); };
        } catch (e) {
          return function (iso) { return new Date(iso).toLocaleString(); };
        }
      })();

      // Built with textContent throughout: every message is text someone typed.
      function render(thread) {
        log.textContent = '';
        thread.messages.forEach(function (m) {
          var li = document.createElement('li');
          li.className = 'convmsg convmsg--' + (m.from === 'shop' ? 'shop' : 'customer');
          var who = document.createElement('div');
          who.className = 'convmsg__who';
          who.textContent = m.from === 'shop' ? d.shop : d.you;
          var text = document.createElement('div');
          text.className = 'convmsg__text';
          text.textContent = m.text;
          var at = document.createElement('div');
          at.className = 'convmsg__at';
          at.textContent = when(m.at);
          li.appendChild(who); li.appendChild(text); li.appendChild(at);
          log.appendChild(li);
        });
        var last = thread.messages[thread.messages.length - 1];
        if (last && last.from !== 'shop') {
          var wait = document.createElement('li');
          wait.className = 'convwait';
          wait.textContent = d.waiting;
          log.appendChild(wait);
        }
        log.scrollTop = log.scrollHeight;
      }

      // `scroll`: bring the box into view — used right after an order, when
      // the customer is at the bottom of the page and the thread just
      // appeared at the top.
      function show(thread, scroll) {
        if (!thread || !thread.messages) { return; }
        render(thread);
        box.hidden = false;
        if (scroll) { box.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      }

      function post(url, body) {
        return fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
      }

      window.slouConv = { stored: stored, remember: remember, show: show };

      var mine = stored();
      if (mine) {
        post('/conversation', mine).then(function (res) {
          // 404: the key matches nothing on the server, so it is useless.
          // 410: the visitor deleted it. The key is KEPT: the shop can
          // restore the thread, and then it shows up here again.
          if (res.status === 404) { forget(); return null; }
          return res.ok ? res.json() : null;
        }).then(function (data) {
          if (data && data.thread) { show(data.thread, false); }
        }).catch(function () { /* offline: the page works without it */ });
      }

      function setErr(msg) {
        err.textContent = msg || '';
        err.hidden = !msg;
        input.classList.toggle('invalid', !!msg);
      }
      input.addEventListener('input', function () { if (input.value.trim()) { setErr(''); } });

      // Delete, after a confirm: the box disappears and stays hidden on later
      // visits. The key stays in localStorage on purpose — the shop keeps the
      // thread and can restore it, and then it shows up here again. (A new
      // order after deleting starts a fresh conversation and replaces it.)
      var del = document.getElementById('cDelete');
      del.addEventListener('click', function () {
        var conv = stored();
        if (!conv || !window.confirm(d.deleteConfirm)) { return; }
        del.disabled = true;
        post('/conversation/delete', conv).then(function (res) {
          if (!res.ok && res.status !== 404) { throw new Error('bad'); }
          if (res.status === 404) { forget(); }
          box.hidden = true;
          log.textContent = '';
          input.value = '';
        }).catch(function () {
          setErr(d.deleteError);
        }).then(function () {
          del.disabled = false;
        });
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var conv = stored();
        var text = input.value.trim();
        if (!text) { setErr(d.empty); input.focus(); return; }
        if (!conv) { return; }

        btn.disabled = true;
        btn.textContent = d.sending;
        setErr('');

        post('/conversation/message', { id: conv.id, key: conv.key, message: text })
          .then(function (res) {
            if (!res.ok) { throw new Error('bad'); }
            return res.json();
          }).then(function (data) {
            input.value = '';
            show(data.thread, false);
          }).catch(function () {
            setErr(d.error);
          }).then(function () {
            btn.disabled = false;
            btn.textContent = d.send;
          });
      });
    })();

    // ---- Homepage order box ----
    (function () {
      var form = document.getElementById('orderForm');
      if (!form) { return; }
      var btn = document.getElementById('oSubmit');
      var note = document.getElementById('oNote');

      // Same rule the field's `pattern` attribute carries and the same one the
      // server applies: something, an @, something, a dot, a 2+ letter TLD.
      // Deliberately loose — the only test that truly proves an address works
      // is mail arriving at it, and a stricter regex mostly rejects valid
      // addresses (apostrophes, +tags, long new TLDs) rather than catching
      // typos.
      var EMAIL = /^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$/;

      // field -> its error slot -> the message, from the form's data-* attrs.
      var CHECKS = [
        { el: form.elements.name,    err: 'oNameErr',  msg: form.dataset.errName,
          bad: function (v) { return !v; } },
        // Optional: empty is fine, the conversation on the site is enough.
        // Only a filled-in address has to look like one.
        { el: form.elements.email,   err: 'oEmailErr', msg: form.dataset.errEmail,
          bad: function (v) { return !!v && !EMAIL.test(v); } },
        { el: form.elements.message, err: 'oMsgErr',   msg: form.dataset.errDetails,
          bad: function (v) { return !v; } },
      ];

      function setError(check, show) {
        var slot = document.getElementById(check.err);
        if (!slot) { return; }
        slot.textContent = show ? check.msg : '';
        slot.hidden = !show;
        check.el.classList.toggle('invalid', !!show);
        // Announced by a screen reader through aria-describedby on the field.
        check.el.setAttribute('aria-invalid', show ? 'true' : 'false');
      }

      // Returns the first invalid field, or null. Every field is checked (not
      // just up to the first failure) so all the problems show at once rather
      // than one per attempt.
      function firstInvalid() {
        var first = null;
        CHECKS.forEach(function (check) {
          var bad = check.bad(check.el.value.trim());
          setError(check, bad);
          if (bad && !first) { first = check; }
        });
        return first;
      }

      // Clear a field's error as soon as it becomes valid, so the message goes
      // away while typing rather than only on the next submit.
      CHECKS.forEach(function (check) {
        check.el.addEventListener('input', function () {
          if (!check.bad(check.el.value.trim())) { setError(check, false); }
        });
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var invalid = firstInvalid();
        if (invalid) {
          invalid.el.focus();
          note.hidden = true;
          return;   // nothing is sent until every field passes
        }

        btn.disabled = true;
        btn.textContent = form.dataset.sending;
        note.hidden = true;

        fetch('/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: form.elements.name.value,
            email: form.elements.email.value,
            message: form.elements.message.value,
            // An existing conversation, if this browser has one: the order
            // then joins it rather than opening a second thread.
            conv: window.slouConv ? window.slouConv.stored() : null
          })
        }).then(function (res) {
          if (!res.ok) { throw new Error('bad'); }
          return res.json();
        }).then(function (data) {
          // The browser now holds the conversation — that is the customer's
          // "account" — and the thread appears at the top of the page.
          if (window.slouConv && data && data.conv) {
            window.slouConv.remember(data.conv);
            window.slouConv.show(data.thread, true);
          }
          note.textContent = form.dataset.ok;
          note.className = 'form-note ok';
          note.hidden = false;
          form.reset();
          // reset() empties the fields but leaves any error slots showing.
          CHECKS.forEach(function (check) { setError(check, false); });
        }).catch(function () {
          note.textContent = form.dataset.error;
          note.className = 'form-note err';
          note.hidden = false;
        }).then(function () {
          btn.disabled = false;
          btn.textContent = form.dataset.send;
        });
      });
    })();
  </script>

</body>
</html>

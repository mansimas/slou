    })();

    // ---- Christmas offer ----
    // Loops play only while on screen; the file is attached the first time a
    // card comes near the viewport. Reduced motion: posters only.
    (function () {
      var videos = [].slice.call(document.querySelectorAll('.xcard__video'));
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (videos.length && !still && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            var v = e.target;
            if (e.isIntersecting) {
              if (v.dataset.src) { v.src = v.dataset.src; v.removeAttribute('data-src'); }
              var p = v.play();
              if (p && p.catch) { p.catch(function () {}); }
            } else {
              v.pause();
            }
          });
        }, { rootMargin: '200px 0px' });
        videos.forEach(function (v) { io.observe(v); });
      }

      // Side by side, the two cards' rows are matched in height (title,
      // description, prices, bulk pill, engraving line), so every row and the
      // button sit at the same level in both even when one description wraps
      // to more lines, which differs by language. Stacked (one column) there
      // is nothing to line up, so the heights are released.
      var cards = [].slice.call(document.querySelectorAll('.xcard'));
      var ROWS = ['h3', '.xcard__desc', '.xcard__prices', '.xcard__bulk', '.xcard__engrave'];
      function alignRows() {
        var sideBySide = cards.length > 1 && cards[0].getBoundingClientRect().top === cards[1].getBoundingClientRect().top;
        ROWS.forEach(function (sel) {
          var els = cards.map(function (c) { return c.querySelector('.xcard__body ' + sel); }).filter(Boolean);
          els.forEach(function (el) { el.style.minHeight = ''; });
          if (!sideBySide) { return; }
          var h = Math.max.apply(null, els.map(function (el) { return el.getBoundingClientRect().height; }));
          els.forEach(function (el) { el.style.minHeight = h + 'px'; });
        });
      }
      if (cards.length > 1) {
        alignRows();
        window.addEventListener('resize', alignRows);
        if (document.fonts && document.fonts.ready) { document.fonts.ready.then(alignRows); }
      }

      // "Order": put the offer into the order form's message and go there.
      // Only overwrites a message that is empty or still one of these
      // prefills, never something the visitor has typed themselves.
      var msg = document.getElementById('oMsg');
      var prefills = [].slice.call(document.querySelectorAll('.xcard__cta')).map(function (a) { return a.dataset.prefill; });
      [].slice.call(document.querySelectorAll('.xcard__cta')).forEach(function (a) {
        a.addEventListener('click', function (e) {
          var box = document.getElementById('order');
          if (!msg || !box) { return; }
          e.preventDefault();
          if (!msg.value.trim() || prefills.indexOf(msg.value) >= 0) { msg.value = a.dataset.prefill; }
          box.scrollIntoView({ behavior: 'smooth', block: 'start' });
          setTimeout(function () { msg.focus({ preventScroll: true }); }, 500);
        });
      });

      // Photo slideshow. Clicking a thumbnail opens every photo of that
      // product on a sliding track: arrows, dots, ← → keys and swiping move
      // between them, Esc or × closes. Wraps around at both ends.
      var dlg = document.getElementById('xlight');
      if (!dlg || !dlg.showModal) { return; }
      var stage = dlg.querySelector('.xlight__stage');
      var track = dlg.querySelector('.xlight__track');
      var dots = dlg.querySelector('.xlight__dots');
      var count = dlg.querySelector('.xlight__count');
      var prev = dlg.querySelector('.xlight__prev');
      var next = dlg.querySelector('.xlight__next');
      var total = 0, at = 0;

      function go(i) {
        if (!total) { return; }
        at = (i + total) % total;
        track.style.transform = 'translateX(' + (-at * 100) + '%)';
        count.textContent = (at + 1) + ' / ' + total;
        if (typeof playCurrent === 'function') { setTimeout(playCurrent, 50); }
        [].slice.call(dots.children).forEach(function (d, n) {
          d.setAttribute('aria-current', n === at ? 'true' : 'false');
        });
      }

      function open(group, index) {
        // The product's clip first (if it has one), then its photos.
        var srcs = [].slice.call(document.querySelectorAll(
          '.xcard__video[data-group="' + group + '"], .xthumb[data-group="' + group + '"]'))
          .map(function (x) { return { src: x.dataset.full, video: x.tagName === 'VIDEO' }; });
        total = srcs.length;
        track.textContent = '';
        dots.textContent = '';
        srcs.forEach(function (item, n) {
          var slide = document.createElement('div');
          slide.className = 'xslide';
          var media;
          if (item.video) {
            media = document.createElement('video');
            media.muted = true; media.loop = true; media.playsInline = true; media.autoplay = true;
            media.setAttribute('playsinline', '');
          } else {
            media = document.createElement('img');
            media.alt = '';
          }
          media.src = item.src;
          media.draggable = false;
          slide.appendChild(media);
          track.appendChild(slide);
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.setAttribute('aria-label', (n + 1) + ' / ' + total);
          dot.addEventListener('click', function () { go(n); });
          dots.appendChild(dot);
        });

        // A double-click also fires two plain clicks, which would toggle play
        // twice and land back where it started, so the single-click action is
        // held for the double-click window and dropped if a second click lands.
        // The buttons and control strip are exempt: scrubbing or muting must
        // not also pause the video.
        var clickHold = null;
        function onControl(e) {

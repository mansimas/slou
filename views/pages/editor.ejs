    // the page pdf.js runs it in the page itself, no cross-origin Worker needed
    var PDFJS = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/';
    function script(src) {
      return new Promise(function (ok, fail) {

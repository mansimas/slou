      label('\u00d8 ' + mm(HOLE_R * 2), -W / 2 - 1.6, HOLE_Y + 0.9);
    }

    var SPECS = { width: mm(W), height: mm(H), spacing: mm(STITCH_PITCH), inset: mm(STITCH_INSET),
                  thickness: card ? mm(CARD_THICK) + ' (2 \u00d7 ' + mm(CARD_POCKET) + ' + 2 \u00d7 ' + mm(CARD_BODY) + ')' : mm(THICK),
                  hole: card ? '\u2014' : '\u00d8 ' + mm(HOLE_R * 2) };

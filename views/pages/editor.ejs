    // the card wallet's legend and specs, on a page of their own
    if (legendPage) { doc.addPage(); legendPage(); }

    var wm = new window.jspdf.jsPDF({ unit: 'mm', format: 'a4' });
    for (var pg = 1; pg < doc.internal.getNumberOfPages(); pg++) { wm.addPage(); }
    // placed by hand rather than at random, so every download looks the same and
    // no two stamps touch: x, y (mm), size, tilt (degrees)
    watermark(wm, card ? [
      // the four templates, each its own size (the owner, 2026-10-29: they read too alike)
      [[65, 91, 1.35, -12], [145, 96, 0.7, 9], [155, 128, 0.4, -18], [65, 190, 0.8, 14], [145, 180, 1.25, -8],
       [110, 17, 0.4, 8], [30, 270, 0.85, -8], [105, 262, 0.6, -4], [175, 275, 0.5, 14]],
      [[60, 100, 1.0, -10], [66, 165, 0.9, 12],                                          // the picture
       [170, 100, 0.7, 8], [170, 150, 0.6, -12],                                         // the specs
       [55, 250, 0.8, -6], [150, 250, 0.8, 10], [110, 20, 0.55, 6], [110, 285, 0.4, -10]],  // the work process
      [[50, 45, 0.8, -10], [55, 105, 0.6, 12], [150, 45, 0.75, 8], [155, 108, 0.65, -12],  // the work process, the links
       [100, 180, 0.9, 4], [40, 250, 0.6, -15], [170, 240, 0.7, 10], [105, 285, 0.45, 0]]
    ] : [
      [[60, 128, 0.7, 10], [64, 170, 0.7, -14],                                          // the keyfob
       [157, 140, 0.95, -8], [165, 85, 0.65, 12],                                        // the specs, the legend
       [110, 20, 0.55, -6], [25, 60, 0.6, -10], [30, 230, 0.8, 14], [175, 235, 0.6, -15], [110, 275, 0.7, 6]]
    ]);
    return flatten(doc, wm, links).then(function (out) {
      out.save(card ? 'slou-card-wallet-pattern.pdf' : 'slou-keyfob-pattern-' + state.shape + '.pdf');
    });
  }

  document.getElementById('kfPattern').addEventListener('click', function (ev) {
    var btn = ev.currentTarget, label = btn.textContent;
    btn.disabled = true; btn.textContent = I18N.pattern.loading;
    loadPdf().then(makePattern).catch(function (err) { console.error(err); }).then(function () {
      btn.disabled = false; btn.textContent = label;
    });
  });

  document.getElementById('kfShot').addEventListener('click', function () {
    renderer.render(scene, camera);
    var a = document.createElement('a');
    a.download = state.product === 'card' ? 'slou-card-wallet.png' : 'slou-keyfob.png';
    a.href = renderer.domElement.toDataURL('image/png');
    a.click();
  });

  function resize() {
    var w = stage.clientWidth, h = stage.clientHeight;
    renderer.setSize(w, h, false);
    labelRenderer.setSize(w, h);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  new ResizeObserver(resize).observe(stage);

  paintCalib();
  build();
  applyColors();
  resize();
  renderer.setAnimationLoop(function () {
    controls.update();
    renderer.render(scene, camera);
    labelRenderer.render(scene, camera);
  });
</script>

        for (var k = 0; k < bytes.length; k += 0x8000) { bin += String.fromCharCode.apply(null, bytes.subarray(k, k + 0x8000)); }
        return btoa(bin);
      });
    pdfReady = Promise.all([lib, font, pdfjs]).then(function (r) { return r[1]; });
    pdfReady.catch(function () { pdfReady = null; });   // let a later click retry
    return pdfReady;
  }

  function pressedLabel(group) {
    var b = document.querySelector('[data-group="' + group + '"] [aria-pressed="true"]');
    return b ? (b.getAttribute('aria-label') || b.textContent).trim() : '';
  }

  // Print calibration, asked for by the owner (2026-10-14). The pattern carries
  // two rulers: 200 mm across the foot of the sheet and 290 mm down its left
  // edge, drawn — like everything else that states a size — `cfx` and `cfy`
  // long. On the first print (fields at 20 and 29) the rulers are drawn at
  // their true length, so measuring them shows exactly what the printer does to
  // each axis. Type those two measurements in and the whole sheet is drawn
  // larger by the same percentages, so the next print comes out true size —
  // including the rulers, which then read 200 and 290 mm again. One factor per
  // axis because a printer need not squeeze both the same: this one takes 4%
  // off the width and 2.5% off the height.
  var calibX = document.getElementById('kfCalibX');
  var calibY = document.getElementById('kfCalibY');
  var calibNote = document.getElementById('kfCalibNote');
  function calibValue(input, nominal) {
    var v = parseFloat(input.value);
    return (v > nominal * 0.7 && v < nominal * 1.4) ? v : nominal;
  }
  function calibXf() { return 18 / calibValue(calibX, 18); }
  function calibYf() { return 27 / calibValue(calibY, 27); }
  function paintCalib() {
    calibNote.textContent = I18N.calib.hint + ' · × ' + calibXf().toFixed(3) + ' / × ' + calibYf().toFixed(3);
  }
  [['kfCalibX', calibX], ['kfCalibY', calibY]].forEach(function (pair) {
    try {
      var saved = window.localStorage.getItem(pair[0]);
      if (saved) { pair[1].value = saved; }
    } catch (err) { /* private mode: just do not remember it */ }
    function keep() {
      try { window.localStorage.setItem(pair[0], pair[1].value); } catch (err) {}
      paintCalib();
    }
    pair[1].addEventListener('input', keep);
    pair[1].addEventListener('change', keep);
  });

  // Every page rendered, watermark and all, into one picture, and the PDF
  // rebuilt from those pictures (the owner, 2026-10-27: make the watermark
  // harder to take off). No separate watermark object or text is left for a PDF
  // editor to select and delete; it is in the same pixels as the lines. 400 dpi
  // keeps the lines to 0.06 mm and a page under the 16.7 M pixel canvas limit
  // of phones, and the picture fills the A4 page exactly, so the calibration
  // is untouched.
  //
  // The watermark comes in as its own PDF (`wm`, a page per page, drawn solid)
  // and is coloured here rather than in jsPDF (the owner, 2026-10-27): a smooth
  // gradient across the page, with a second, round one over it in another
  // direction, and an ink grain through it. A watermark of one even tone can be
  // picked out in one click; this one has no single tone to pick. Most people
  // print black and white (the owner), so what changes is how dark it is, not
  // just its colour: the stops go from about 4% to 12% darker than the paper
  // (3% to 9% until the owner asked for it a touch stronger, 2026-10-29),
  // and the grain survives a grey print too. It is rendered at 200 dpi and laid
  // on the lines with `multiply`, so it darkens the paper the way ink would and
  // the lines stay black through it.
  var WM_STOPS = [   // along the page's diagonal: colour, strength (darkening ≈ strength × (1 - lightness))
    [0, '60,40,28', 0.14], [0.22, '176,122,58', 0.09], [0.41, '91,90,53', 0.17],
    [0.6, '176,122,58', 0.08], [0.8, '60,40,28', 0.13], [1, '91,90,53', 0.09]
  ];
  function flatten(doc, wm, links) {
    var DPI = 400, WM_DPI = 200;
    var open = function (d) { return window.pdfjsLib.getDocument({ data: d.output('arraybuffer') }).promise; };
    function draw(src, p, dpi, fill) {
      return src.getPage(p).then(function (pg) {
        var vp = pg.getViewport({ scale: dpi / 72 });
        var c = document.createElement('canvas');
        c.width = Math.round(vp.width); c.height = Math.round(vp.height);
        var g = c.getContext('2d');
        if (fill) { g.fillStyle = fill; g.fillRect(0, 0, c.width, c.height); }
        return pg.render({ canvasContext: g, viewport: vp, background: 'rgba(0,0,0,0)' }).promise
          .then(function () { return c; });
      });
    }
    // the watermark layer's shapes, filled with the two gradients in place of black
    function tint(c, p) {
      var g = c.getContext('2d'), w = c.width, h = c.height;
      var flip = p % 2 === 0;   // the next page runs the other way
      var lin = g.createLinearGradient(flip ? w : 0, 0, flip ? 0 : w, h);
      WM_STOPS.forEach(function (s) { lin.addColorStop(s[0], 'rgba(' + s[1] + ',' + s[2] + ')'); });
      g.globalCompositeOperation = 'source-in';
      g.fillStyle = lin; g.fillRect(0, 0, w, h);
      var rad = g.createRadialGradient(w * (flip ? 0.3 : 0.7), h * 0.62, 0, w * 0.5, h * 0.5, h * 0.75);
      rad.addColorStop(0, 'rgba(60,40,28,0.065)'); rad.addColorStop(0.5, 'rgba(91,90,53,0)');
      rad.addColorStop(1, 'rgba(176,122,58,0.05)');
      g.globalCompositeOperation = 'source-atop';
      g.fillStyle = rad; g.fillRect(0, 0, w, h);

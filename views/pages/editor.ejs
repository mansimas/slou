<%
  /* Keyfob designer. three.js is loaded as an ES module from jsDelivr (pinned
     version) through the import map below, so nothing is added to the asset
     pipeline. The leather grain is drawn on a canvas at load time — no image
     files. Units in the scene are centimetres. */
  var e = t.editor;
  /* The key ring the owner uses (Buckleguy B2020, solid iron, all four
     finishes): a split ring of flat strip wire, and only ever the 1″ one.
     `id` is the ring's *inside* diameter — the dimension the product is sold
     by — and `wire` the width of the strip; both in cm. The model in the scene
     (RING below) is built from it. */
  var ring = { id: 2.60, wire: 0.34 };   // 26.0 mm bore, 3.4 mm strip
%>
<style>
  .kf { padding: 40px 0 70px; }
  .kf__head { text-align: center; max-width: 640px; margin: 0 auto 28px; }
  .kf__head h1 { font-family: var(--serif); font-weight: 600; font-size: clamp(28px, 4vw, 40px); line-height: 1.2; margin: 6px 0 10px; }
  .kf__head p { color: var(--muted); }
  .kf__grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 24px; align-items: start; }
  .kf__stage { position: relative; height: min(72vh, 640px); border-radius: 18px; overflow: hidden;
    background: radial-gradient(circle at 50% 40%, #fbf6ee, #e6dac5); border: 1px solid var(--line); }
  .kf__stage canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  .kf__stage canvas:active { cursor: grabbing; }
  .kf__hint { position: absolute; left: 0; right: 0; bottom: 12px; text-align: center; font-size: 12px; color: var(--muted); pointer-events: none; }
  .kf__panel { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 22px; display: grid; gap: 20px; }
  .kf__label { display: block; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .kf__opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .kf__btn { font: inherit; font-size: 14px; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; }
  .kf__btn[aria-pressed="true"] { background: var(--ink); color: #f7f1e6; border-color: var(--ink); }
  .kf__sw { width: 34px; height: 34px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px var(--line); cursor: pointer; padding: 0; }
  .kf__sw[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--ink); }
  .kf__input { width: 100%; font: inherit; font-size: 16px; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--line); background: #fff; text-transform: uppercase; letter-spacing: 2px; }
  .kf__num { text-transform: none; letter-spacing: 0; }
  .kf__sub { display: block; font-size: 12px; color: var(--muted); margin: 0 0 4px; }
  .kf__note { font-size: 12px; color: var(--muted); margin: 6px 0 0; }
  .kf__actions { display: grid; gap: 10px; }
  .kf__cta { display: block; text-align: center; font: inherit; font-size: 15px; padding: 12px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--leather-dark); background: var(--leather-dark); color: #f7f1e6; }
  .kf__cta--ghost { background: transparent; color: var(--leather-dark); }
  .kf__labels { position: absolute; inset: 0; pointer-events: none; }
  .kf__full { position: absolute; top: 12px; right: 12px; z-index: 2; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line);
    background: rgba(255,255,255,.85); color: var(--ink); cursor: pointer; display: grid; place-items: center; }
  .kf__full:hover { background: #fff; }
  .kf__full svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .kf__full .kf__shrink, .kf__stage.is-full .kf__full .kf__grow { display: none; }
  .kf__stage.is-full .kf__full .kf__shrink { display: block; }
  /* Fullscreen API, or the fixed-position fallback where it is missing (iPhone). */
  .kf__stage.is-full { position: fixed; inset: 0; z-index: 1000; height: auto; border-radius: 0; border: 0; }
  .kf__stage:fullscreen { height: 100%; border-radius: 0; }
  .kf__dim { font-size: 12px; line-height: 1; padding: 4px 7px; border-radius: 999px; background: rgba(41,36,31,.88); color: #f7f1e6; white-space: nowrap; }
  .kf__specs { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; font-size: 14px; margin-top: 12px; }
  .kf__specs dt { color: var(--muted); }
  .kf__specs dd { font-variant-numeric: tabular-nums; text-align: right; }
  .kf__specs[hidden] { display: none; }
  @media (max-width: 860px) {
    .kf__grid { grid-template-columns: minmax(0, 1fr); }
    .kf__stage { height: 56vh; }
  }
</style>

<section class="kf">
  <div class="wrap">
    <header class="kf__head">
      <h1><%= e.title %></h1>
      <p><%= e.lead %></p>
    </header>

    <div class="kf__grid">
      <div class="kf__stage" id="kfStage">
        <p class="kf__hint" id="kfHint" data-rotate="<%= e.hint %>" data-pan="<%= e.hintPan %>"><%= e.hint %></p>
        <button type="button" class="kf__full" id="kfFull" aria-label="<%= t.videos.full %>" title="<%= t.videos.full %>"
                data-enter="<%= t.videos.full %>" data-exit="<%= e.exitFull %>">
          <svg class="kf__grow" viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
          <svg class="kf__shrink" viewBox="0 0 24 24"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"/></svg>
        </button>
      </div>

      <div class="kf__panel">
        <div>
          <span class="kf__label"><%= e.shape %></span>
          <div class="kf__opts" data-group="shape">
            <% ['rect', 'arch', 'point'].forEach(function (k, i) { %>
              <button type="button" class="kf__btn" data-value="<%= k %>" aria-pressed="<%= i === 1 %>"><%= e.shapes[k] %></button>
            <% }); %>
          </div>
        </div>

        <div>
          <span class="kf__label"><%= e.leather %></span>
          <div class="kf__opts" data-group="leather">
            <% [['tan', '#c08a55'], ['cognac', '#9a5527'], ['brown', '#5a3820'], ['black', '#222020'], ['burgundy', '#5e1f24'], ['olive', '#5b5a35']].forEach(function (c, i) { %>
              <button type="button" class="kf__sw" data-value="<%= c[1] %>" style="background:<%= c[1] %>" title="<%= e.colors[c[0]] %>" aria-label="<%= e.colors[c[0]] %>" aria-pressed="<%= i === 1 %>"></button>
            <% }); %>
          </div>
        </div>

        <div>
          <span class="kf__label"><%= e.thread %></span>
          <div class="kf__opts" data-group="thread">
            <% [['cream', '#eadcbf'], ['white', '#f6f6f2'], ['brown', '#4a2e1a'], ['black', '#1b1b1b'], ['red', '#a32a26']].forEach(function (c, i) { %>
              <button type="button" class="kf__sw" data-value="<%= c[1] %>" style="background:<%= c[1] %>" title="<%= e.colors[c[0]] %>" aria-label="<%= e.colors[c[0]] %>" aria-pressed="<%= i === 0 %>"></button>
            <% }); %>
          </div>
        </div>

        <div>
          <span class="kf__label"><%= e.ring %></span>
          <div class="kf__opts" data-group="ring">
            <% ['silver', 'brass', 'black', 'gold'].forEach(function (k, i) { %>
              <button type="button" class="kf__btn" data-value="<%= k %>" aria-pressed="<%= i === 0 %>"><%= e.rings[k] %></button>
            <% }); %>
          </div>
        </div>

        <div>
          <label class="kf__label" for="kfText"><%= e.initials %></label>
          <input class="kf__input" id="kfText" type="text" maxlength="8" autocomplete="off" placeholder="<%= e.initialsPh %>">
        </div>

        <div>
          <div class="kf__opts">
            <button type="button" class="kf__btn" id="kfMeasure" aria-pressed="false"><%= e.measure.toggle %></button>
            <button type="button" class="kf__btn" id="kfLock" aria-pressed="false" hidden><%= e.lockTop %></button>
          </div>
          <dl class="kf__specs" id="kfSpecs" hidden>
            <% ['width', 'height', 'thickness', 'hole', 'spacing', 'inset'].forEach(function (k) { %>
              <dt><%= e.measure[k] %></dt><dd data-spec="<%= k %>"></dd>
            <% }); %>
          </dl>
        </div>

        <div>
          <span class="kf__label"><%= e.calib.label %></span>
          <label class="kf__sub" for="kfCalibX"><%= e.calib.x %></label>
          <input class="kf__input kf__num" id="kfCalibX" type="number" step="0.01" inputmode="decimal" value="18">
          <label class="kf__sub" for="kfCalibY"><%= e.calib.y %></label>
          <input class="kf__input kf__num" id="kfCalibY" type="number" step="0.01" inputmode="decimal" value="27">
          <p class="kf__note" id="kfCalibNote"></p>
        </div>

        <div class="kf__actions">
          <a class="kf__cta" href="/#order"><%= e.order %></a>
          <button type="button" class="kf__cta kf__cta--ghost" id="kfPattern"><%= e.pattern.btn %></button>
          <button type="button" class="kf__cta kf__cta--ghost" id="kfShot"><%= e.download %></button>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="kfI18n"><%- JSON.stringify({ pattern: e.pattern, measure: e.measure, calib: e.calib }).replace(/</g, '\\u003c') %></script>

<script type="importmap">
  { "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
  } }
</script>
<script type="module">
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
  import { CSS2DRenderer, CSS2DObject } from 'three/addons/renderers/CSS2DRenderer.js';

  var W = 3, H = 8;            // keyfob outline, cm
  var BEVEL = 0.04;            // rounded edge; the outline is inset by it so outer size stays exact
  var THICK = 0.35;            // leather thickness, 3.5 mm
  var DEPTH = THICK - 2 * BEVEL;
  var STITCH_INSET = 0.28;     // stitch line distance from the edge (measured: 2.8 mm)
  var STITCH_PITCH = 0.385;    // saddle stitch, 3.85 mm diamond chisel spacing
  // Pricking iron slits, measured on the real punched keyfob: ~45 deg to the
  // stitch line, ~1.2 mm long. The thread runs between the inner ends of two
  // slits, so it leans the opposite way to them, ~13 deg off the line.
  var SLIT_ANGLE = 45 * Math.PI / 180;
  var SLIT_HALF = 0.05;
  var ARC_R = 1.8;             // end arc radius
  var CORNER_R = 0.25;         // rectangle's cut corners
  var OVERLAP = 2;             // stitches sewn twice where the thread ends
  var JOINT_GAP = 0.045;       // centre-to-centre of the joint's two threads
  var JOINT_DROP = 0.04;       // the second thread's slide along the line
  var HOLE_Y = H / 2 - 1.0, HOLE_R = 0.4;   // 8 mm hole
  var TEX_SPAN = 10;           // cm covered by the leather texture
  var TEX_N = 1024;            // texture resolution

  // Key ring: the size above, as the scene wants it. It is one strip of flat
  // wire wound two turns — a single spiral, not two rings. RING_GAP is the
  // angle between its two cut ends (the split), and the wire crosses from the
  // back turn to the front one inside that gap.
  var RING = <%- JSON.stringify(ring) %>;
  var RING_GAP = 0.26;
  var RING_NECK = 0.15;   // how much narrower the wire is where it crosses the gap
  var RING_FULL = 0.12;   // and how much fuller (thicker along the axis), seen from the side
  // Its cut ends: RING_CUT is how far the outer face of each end sits back
  // from the inner one (a slanted cut, not square across the wire — the back
  // of each end reaches past its front), RING_ROUND the radius the corners of
  // the cut are rounded to, just enough to take the sharp edge off.
  var RING_CUT = 0.124;   // 20° off square across the 3.4 mm wire (24° was too much)
  var RING_ROUND = 0.02;

  var state = { shape: 'arch', leather: '#9a5527', thread: '#eadcbf', ring: 'silver', text: '' };

  // ---------- scene ----------
  var stage = document.getElementById('kfStage');
  var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  stage.insertBefore(renderer.domElement, stage.firstChild);
  var labelRenderer = new CSS2DRenderer();
  labelRenderer.domElement.className = 'kf__labels';
  stage.appendChild(labelRenderer.domElement);

  var scene = new THREE.Scene();
  scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;

  var camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
  camera.position.set(4, 2, 19);

  var controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.enablePan = false;
  controls.minDistance = 7;
  controls.maxDistance = 30;
  // Zoom towards the pointer, not the middle of the screen: the wheel carries
  // the target in to whatever is under the cursor, so you can close in on the
  // initials or the ring without having to rotate the fob back to centre first.
  controls.zoomToCursor = true;
  controls.target.set(0, 0.8, 0);
  controls.autoRotate = true;
  controls.autoRotateSpeed = 1.2;
  controls.addEventListener('start', function () { controls.autoRotate = false; });

  var sun = new THREE.DirectionalLight(0xfff3e0, 2.2);
  sun.position.set(5, 8, 10);
  var backLight = new THREE.DirectionalLight(0xfff3e0, 1.2);   // so the back isn't left in shadow
  backLight.position.set(-4, 5, -10);
  scene.add(sun, backLight, new THREE.HemisphereLight(0xfff8ee, 0x8a6a44, 0.6));

  var fob = new THREE.Group();
  scene.add(fob);

  // ---------- leather texture ----------
  function rnd(a, b) { return a + Math.random() * (b - a); }

  // Grayscale grain: pebbles + fine creases, shared by colour and bump maps.
  var grain = (function () {
    var c = document.createElement('canvas'); c.width = c.height = TEX_N;
    var g = c.getContext('2d');
    g.fillStyle = '#808080'; g.fillRect(0, 0, TEX_N, TEX_N);
    for (var k = 0; k < 70000; k++) {
      var r = rnd(1, 2.6);
      g.fillStyle = Math.random() < 0.5 ? 'rgba(255,255,255,.09)' : 'rgba(0,0,0,.11)';
      g.beginPath(); g.ellipse(rnd(0, TEX_N), rnd(0, TEX_N), r, r * rnd(0.6, 1.2), rnd(0, 3), 0, 7); g.fill();
    }
    g.lineCap = 'round';
    for (k = 0; k < 160; k++) {
      var x = rnd(0, TEX_N), y = rnd(0, TEX_N), a = rnd(0, 7);
      g.strokeStyle = 'rgba(0,0,0,.13)'; g.lineWidth = rnd(0.6, 1.6);
      g.beginPath(); g.moveTo(x, y);
      for (var j = 0; j < 8; j++) { a += rnd(-0.4, 0.4); x += Math.cos(a) * 8; y += Math.sin(a) * 8; g.lineTo(x, y); }
      g.stroke();
    }
    var out = document.createElement('canvas'); out.width = out.height = TEX_N;
    var o = out.getContext('2d');
    o.filter = 'blur(0.7px)'; o.drawImage(c, 0, 0);
    return out;
  })();

  function canvasTex(srgb) {
    var c = document.createElement('canvas'); c.width = c.height = TEX_N;
    var tex = new THREE.CanvasTexture(c);
    tex.repeat.set(1 / TEX_SPAN, 1 / TEX_SPAN);
    tex.offset.set(0.5, 0.5);
    tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
    if (srgb) { tex.colorSpace = THREE.SRGBColorSpace; }
    return tex;
  }
  var colorTex = canvasTex(true), bumpTex = canvasTex(false), backColorTex = canvasTex(true);

  // Where the initials go, in shape coordinates (cm): centre, letter size,
  // and whether they run along the length. Shared with the pattern PDF.
  function textLayout() {
    var txt = state.text.trim().toUpperCase();
    if (!txt) { return null; }
    var vertical = txt.length > 3;
    var room = vertical ? H - 4.4 : W - 1;   // stays inside the stitching
    return { txt: txt, vertical: vertical, x: 0, y: vertical ? -0.4 : -1.3,
             size: Math.min(vertical ? 0.8 : 1.1, room / (txt.length * 0.72)) };
  }

  // Draws the initials, debossed, onto a texture canvas.
  function drawText(g, style) {
    var L = textLayout();
    if (!L) { return; }
    var px = TEX_N / TEX_SPAN, txt = L.txt, vertical = L.vertical, size = L.size * px;
    g.save();
    g.translate(TEX_N / 2 + L.x * px, TEX_N / 2 - L.y * px);
    if (vertical) { g.rotate(-Math.PI / 2); }
    g.font = '600 ' + size + 'px Helvetica, "Helvetica Neue", Arial, sans-serif';
    g.textAlign = 'center'; g.textBaseline = 'middle';
    g.fillStyle = style;
    g.filter = 'blur(1px)';
    g.fillText(txt, 0, 0);
    g.restore();
  }

  function paintTextures() {
    // colour: light grain (multiplied by material colour) + darker burnished letters
    [colorTex, backColorTex].forEach(function (tex, i) {
      var g = tex.image.getContext('2d');
      g.filter = 'none';
      g.drawImage(grain, 0, 0);
      g.fillStyle = 'rgba(255,255,255,.55)'; g.fillRect(0, 0, TEX_N, TEX_N);
      if (i === 0) { drawText(g, 'rgba(28,13,2,.62)'); }
      tex.needsUpdate = true;
    });
    // bump: grain + pressed-in letters
    var b = bumpTex.image.getContext('2d');
    b.filter = 'none';
    b.drawImage(grain, 0, 0);
    drawText(b, '#000');
    bumpTex.needsUpdate = true;
  }
  paintTextures();

  // ---------- materials ----------
  var leatherMat = new THREE.MeshStandardMaterial({ map: colorTex, bumpMap: bumpTex, bumpScale: 1.5, roughness: 0.72 });
  var backMat = new THREE.MeshStandardMaterial({ map: backColorTex, bumpMap: bumpTex, bumpScale: 1, roughness: 0.85 });
  var edgeMat = new THREE.MeshStandardMaterial({ roughness: 0.45 });  // burnished edge
  // Twisted waxed thread: diagonal plies wound round each stitch.
  var plyTex = (function () {
    // three plies round the thread; repeat set so they run at ~45 deg
    var c = document.createElement('canvas'); c.width = 48; c.height = 48;
    var g = c.getContext('2d');
    g.fillStyle = '#fff'; g.fillRect(0, 0, 48, 48);
    g.strokeStyle = 'rgba(0,0,0,.3)'; g.lineWidth = 5;
    for (var k = -48; k < 96; k += 16) { g.beginPath(); g.moveTo(k, 0); g.lineTo(k + 48, 48); g.stroke(); }
    var tex = new THREE.CanvasTexture(c);
    tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(1, 1.2);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  })();
  // A waxed thread: the ply twist is there but shallow. At bumpScale 0.6 it read
  // as a twisted rope rather than a smooth cord.
  var threadMat = new THREE.MeshStandardMaterial({ roughness: 0.5, map: plyTex, bumpMap: plyTex, bumpScale: 0.25 });
  // The leather pressed in around a hole: soft, because it is not a shape on
  // the grain but the grain being pulled down towards the cut.
  var slitAlpha = (function () {
    var c = document.createElement('canvas'); c.width = c.height = 64;
    var g = c.getContext('2d'), grad = g.createRadialGradient(32, 32, 4, 32, 32, 32);
    grad.addColorStop(0, '#fff'); grad.addColorStop(0.55, '#bbb'); grad.addColorStop(1, '#000');
    g.fillStyle = grad; g.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(c);
  })();
  // The cut itself is solid, not a gradient: an iron cuts the leather rather
  // than denting it, so the slit stays dark and sharp-edged at any zoom.
  var holeMat = new THREE.MeshStandardMaterial({ color: 0x120b06, roughness: 0.9, side: THREE.DoubleSide });
  // The metal is a flat band, so the room it reflects lands on one spot: at full
  // metalness and mirror roughness the ring read as black plastic rather than
  // nickel. Nine tenths metal with a satin roughness keeps the highlight but lets
  // the band read as its finish.
  var ringMat = new THREE.MeshStandardMaterial({ metalness: 0.9, roughness: 0.4 });
  var RINGS = { silver: ['#d8d8dc', 0.40], brass: ['#c9a04a', 0.36], black: ['#1d1d1f', 0.48], gold: ['#e2c05a', 0.36] };

  // The wire of a key ring: its flat section (a chamfered rectangle, `w` across
  // and `t` thick) swept round the arc at radius `R` and capped at both ends.
  // Built by hand: a lathe leaves those ends open, and a lathe's or a tube's
  // section is round — the real ring is flat strip, its wide face outwards.
  // `yAt(u)`, u running 0→1 over the sweep, is where the wire sits along the
  // ring's axis as it winds: that one function is what makes the two turns a
  // single spiral — both turns of the ring go through here, as one sweep.
  //
  // Each end is cut on the slant (`cut`: the outer face stops that much short
  // of the inner one) and its corners rounded to `round`: the last few rings
  // of the sweep close in on the section a quarter-circle at a time, the
  // first of them set back by the slant, vertex by vertex. `wAt(u)` scales the
  // wire's radial width `w` along the sweep (1 = full), and `oAt(u)` blends
  // the section from its chamfered corners (0) to rounded ones (1), radius
  // `ht * 0.95` — the oval the wire takes where it crosses the split — and
  // thickens it along the axis by `full` there, so the oval reads full.
  function bandGeo(R, w, t, a0, span, yAt, cut, round, wAt, oAt, full) {
    var hw = w / 2, ht = t / 2, ch = ht * 0.35, ro = ht * 0.95, M = 3;
    // the section, CCW in (radial, axial): each corner M + 1 points, laid
    // along the chamfer in `sec` and along the quarter-circle in `oval`
    var sec = [], oval = [];
    [[1, -1], [1, 1], [-1, 1], [-1, -1]].forEach(function (c, ci) {
      for (var k = 0; k <= M; k++) {
        var f = k / M, a = (ci - 1 + f) * Math.PI / 2, a1 = ci * Math.PI / 2, a2 = (ci - 1) * Math.PI / 2,
            cx = c[0] * (hw - ch), cy = c[1] * (ht - ch);
        sec.push([cx + ch * ((1 - f) * Math.cos(a2) + f * Math.cos(a1)),
                  cy + ch * ((1 - f) * Math.sin(a2) + f * Math.sin(a1))]);
        oval.push([c[0] * (hw - ro) + ro * Math.cos(a), c[1] * (ht - ro) + ro * Math.sin(a)]);
      }
    });
    var n = sec.length, v = [], idx = [], i, j, K = 4;
    // one ring of the section: `back(j)` is how far vertex j sits in from the
    // end of the sweep at `end` (0 or 1), `inset` how far it closes in
    function ring(end, back, inset) {
      for (var j = 0; j < n; j++) {

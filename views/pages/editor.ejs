    // Where it crosses between the ends the wire is a touch narrower seen face
    // on, along the ring's axis — its radial width, not its thickness (which
    // was tried first and was not it): one round curve, `RING_NECK` off at its
    // deepest, running between the two cut ends. The ends are cut on the
    // slant, so it reaches past each end's tip to the far corner of its cut
    // (`RING_CUT` back): full width only where the cut is passed entirely.
    // `sin^1.5`, not `sin`: it meets the full width without a corner.
    // Over the same stretch, on the same curve, its section goes oval — the
    // corners rounded — so the crossing reads softer than the rest of the band.
    var neck = RING_CUT / (ri + wire / 2);   // the slant, as an angle on the band
    function crossing(u) {                   // 0 outside the crossing, 1 at its middle
      var s = (u * total - TURN + RING_GAP + neck) / (RING_GAP + 2 * neck);
      return s <= 0 || s >= 1 ? 0 : Math.pow(Math.sin(Math.PI * s), 1.5);
    }
    function wAt(u) { return 1 - RING_NECK * crossing(u); }
    var r = new THREE.Mesh(bandGeo(ri + wire / 2, wire, th, 0, total, yAt, RING_CUT, RING_ROUND, wAt, crossing), ringMat);
    r.rotation.z = Math.PI / 2;   // stand the ring up in the fob's plane
    r.position.set(0, HOLE_Y + ri + wire / 2, 0);   // the band centred on the hole
    fob.add(r);

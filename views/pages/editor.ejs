      // random, like ink from a real stamp
      var img = g.getImageData(0, 0, w, h), px = img.data;
      for (var k = 3; k < px.length; k += 4) {
        if (px[k]) { px[k] = Math.min(255, px[k] * (0.45 + Math.random() * 0.9)); }
      }
      g.putImageData(img, 0, 0);
      return c;
    }
    return Promise.all([open(doc), open(wm)]).then(function (srcs) {
      var src = srcs[0], mark = srcs[1];
      var out = new window.jspdf.jsPDF({ unit: 'mm', format: 'a4' });
      out.setProperties({ title: 'SLOU', author: 'SLOU', creator: 'slou.lt' });
      function page(p) {
        return Promise.all([draw(src, p, DPI, '#fff'), draw(mark, p, WM_DPI)]).then(function (cs) {
          var c = cs[0], g = c.getContext('2d');
          g.globalCompositeOperation = 'multiply';
          g.drawImage(tint(cs[1], p), 0, 0, c.width, c.height);
          if (p > 1) { out.addPage(); }
          out.addImage(c.toDataURL('image/jpeg', 0.92), 'JPEG', 0, 0, 210, 297);
          (links || []).forEach(function (l) {   // a picture has no links, so they go back on top
            if (l.page === p) { out.link(l.x, l.y, l.w, l.h, { url: l.url }); }
          });
          c.width = c.height = cs[1].width = cs[1].height = 0;   // let the memory go before the next page
        });
      }
      var chain = Promise.resolve();
      for (var p = 1; p <= src.numPages; p++) { chain = chain.then(page.bind(null, p)); }
      return chain.then(function () { src.destroy(); mark.destroy(); return out; });
    });
  }

  // The watermark on every PDF the editor makes (the owner, 2026-10-27): a
  // round stamp - SLOU in the middle, LEATHERCRAFT round the top, SLOU.LT round
  // the bottom, all Helvetica capitals like the logo - big and small, each at
  // its own tilt. They sit on what someone would most want to clean off and
  // take (the owner, 2026-10-29): every template, the picture, the specs and
  // the work process, with smaller ones round the rest of the page. `spots`
  // is one list per page; pages past its end use its last. Drawn solid black
  // on a document of its own; `flatten` colours it and makes it faint, so the
  // cut and stitch lines read through.
  function watermark(doc, spots) {
    var PT = 2.835;                                     // pt per mm
    var R, RI, RM, TILT, K;                             // the stamp being drawn
    var cap = function (size) { return size / PT * 0.72; };
    // one character (or a word) centred on (x, y) in the stamp's own y-up frame,
    // its baseline turned to `a` radians; page y runs down
    function put(cx, cy, s, x, y, a, size) {
      var w = doc.getTextWidth(s), h = cap(size);
      var bx = x - Math.cos(a) * w / 2 + Math.sin(a) * h / 2;
      var by = y - Math.sin(a) * w / 2 - Math.cos(a) * h / 2;
      doc.text(s, cx + bx, cy - by, { angle: a * 180 / Math.PI });
    }
    // a word round the ring, centred on polar angle `mid`; `top` reads clockwise
    // over the top, otherwise anticlockwise along the bottom
    function arc(cx, cy, word, mid, top, size, track) {
      doc.setFontSize(size);
      var ws = word.split('').map(function (ch) { return doc.getTextWidth(ch); });
      var span = ws.reduce(function (a, b) { return a + b; }, 0) + track * (ws.length - 1);
      var t = mid + (top ? 1 : -1) * span / RM / 2;
      for (var k = 0; k < ws.length; k++) {
        var th = t + (top ? -1 : 1) * ws[k] / 2 / RM;
        put(cx, cy, word[k], RM * Math.cos(th), RM * Math.sin(th), th + (top ? -1 : 1) * Math.PI / 2, size);
        t += (top ? -1 : 1) * (ws[k] + track) / RM;
      }
    }
    // a stamp at (cx, cy), `k` times the 48 mm one, turned `deg` degrees
    function stamp(cx, cy, k, deg) {
      K = k; R = 24 * k; RI = 17 * k; RM = 20.5 * k; TILT = deg * Math.PI / 180;
      doc.setLineWidth(0.7 * K); doc.circle(cx, cy, R, 'S');
      doc.setLineWidth(0.25 * K); doc.circle(cx, cy, R - 1.2 * K, 'S'); doc.circle(cx, cy, RI, 'S');
      doc.setFont('helvetica', 'bold');
      arc(cx, cy, 'LEATHERCRAFT', Math.PI / 2 + TILT, true, 12 * K, 0.9 * K);
      doc.setFont('helvetica', 'normal');
      arc(cx, cy, 'SLOU.LT', -Math.PI / 2 + TILT, false, 10 * K, 1.6 * K);
      [0, Math.PI].forEach(function (th) {               // a dot each side between the words
        doc.circle(cx + RM * Math.cos(th + TILT), cy - RM * Math.sin(th + TILT), 0.7 * K, 'F');
      });
      doc.setFont('helvetica', 'bold'); doc.setFontSize(30 * K);
      put(cx, cy, 'SLOU', 0, 0, TILT, 30 * K);
      [6.8 * K, -6.8 * K].forEach(function (d) {         // a thin rule above and below SLOU
        var c = Math.cos(TILT), s = Math.sin(TILT), L = 10 * K;
        doc.line(cx - c * L - s * d, cy - (-s * L + c * d), cx + c * L - s * d, cy - (s * L + c * d));
      });
    }
    for (var pg = 1; pg <= doc.internal.getNumberOfPages(); pg++) {
      doc.setPage(pg);
      doc.setDrawColor(0); doc.setFillColor(0); doc.setTextColor(0);
      spots[Math.min(pg, spots.length) - 1].forEach(function (s) { stamp(s[0], s[1], s[2], s[3]); });
    }
  }

  // One still of the scene for the pattern: 900 × 1200 px from `pos`,
  // looking at the piece's middle, without the measurements; the view on
  // screen is put back as it was.
  function makePattern(fontB64) {
    var P = I18N.pattern, M = I18N.measure;
    var doc = new window.jspdf.jsPDF({ unit: 'mm', format: 'a4' });
    doc.addFileToVFS('DejaVuSans.ttf', fontB64);
    doc.addFont('DejaVuSans.ttf', 'DejaVu', 'normal');
    doc.setFont('DejaVu');
    doc.setLineCap('round');

    // shape cm -> page mm, y flipped; the keyfob sits left of centre, notes on
    // the right. `cfx`/`cfy` are the calibration: everything the sheet states a
    // size for is drawn that much larger, so the print comes out true size
    // whatever the printer did to the page. Both are 1 (the untouched file)
    // unless the owner has measured the two rulers and typed the lengths in.
    var cfx = calibXf(), cfy = calibYf();
    var OX = 62, OY = 150;
    function X(x) { return OX + x * 10 * cfx; }
    function Y(y) { return OY - y * 10 * cfy; }
    function poly(pts) {
      for (var k = 0; k < pts.length; k++) {
        var a = pts[k], b = pts[(k + 1) % pts.length];
        doc.line(X(a.x), Y(a.y), X(b.x), Y(b.y));
      }

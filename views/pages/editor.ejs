    var card = state.product === 'card', W = card ? CARD_W : KEY_W, H = card ? CARD_H : KEY_H;
    var T = 0.12;  // end tick half-length
    // width, under the piece
    var wy = -H / 2 - 0.8;
    segs([[-W / 2, wy], [W / 2, wy], [-W / 2, wy - T], [-W / 2, wy + T], [W / 2, wy - T], [W / 2, wy + T],
          [-W / 2, -H / 2 - 0.15], [-W / 2, wy - 0.2], [W / 2, -H / 2 - 0.15], [W / 2, wy - 0.2]]);
    label(mm(W), 0, wy);

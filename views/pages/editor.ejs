  // ---------- pattern PDF ----------
  // A 1:1 A4 template: print at 100%, cut, lay on the leather, and punch
  // through the marked slits. jsPDF and a font with Lithuanian letters
  // (DejaVu Sans) are only fetched on the first click, and pdf.js with them,
  // which flattens the finished pages (`flatten`).
  var I18N = JSON.parse(document.getElementById('kfI18n').textContent);
  var pdfReady = null;
  function loadPdf() {
    if (pdfReady) { return pdfReady; }
    var lib = new Promise(function (ok, fail) {
      var el = document.createElement('script');
      el.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
      el.onload = ok; el.onerror = fail;
      document.head.appendChild(el);
    });

      var a = u * total;
      if (a <= TURN - RING_GAP) { return -th / 2; }             // the back turn, flat
      if (a >= TURN) { return th / 2; }                         // the front turn, flat
      var s = (a - TURN + RING_GAP) / RING_GAP;                 // the ramp: smootherstep, so
      return th * (s * s * s * (s * (6 * s - 15) + 10) - 0.5);  // it bends in and out softly
    }
    // Where it crosses between the ends the wire is a touch narrower seen face
    // on, along the ring's axis — its radial width, not its thickness (which
    // was tried first and was not it): one round curve, `RING_NECK` off at its
    // deepest, running between the two cut ends. The ends are cut on the
    // slant, so it reaches past each end's tip to the far corner of its cut
    // (`RING_CUT` back): full width only where the cut is passed entirely.
    // `sin^1.5`, not `sin`: it meets the full width without a corner.
    // Over the same stretch, on the same curve, its section goes oval — the
    // corners rounded — so the crossing reads softer than the rest of the band.
    var neck = RING_CUT / (ri + wire / 2);   // the slant, as an angle on the band
    function crossing(u) {                   // 0 outside the crossing, 1 at its middle
      var s = (u * total - TURN + RING_GAP + neck) / (RING_GAP + 2 * neck);
      return s <= 0 || s >= 1 ? 0 : Math.pow(Math.sin(Math.PI * s), 1.5);
    }
    function wAt(u) { return 1 - RING_NECK * crossing(u); }
    var r = new THREE.Mesh(bandGeo(ri + wire / 2, wire, th, 0, total, yAt, RING_CUT, RING_ROUND, wAt, crossing, RING_FULL), ringMat);
    r.rotation.z = Math.PI / 2;   // stand the ring up in the fob's plane
    r.position.set(0, HOLE_Y + ri + wire / 2, 0);   // the band centred on the hole
    fob.add(r);
  }

  // ---------- grid & measurements ----------
  function mm(cm) { return +(cm * 10).toFixed(2) + ' mm'; }

  var measures = new THREE.Group();
  measures.visible = false;
  scene.add(measures);

  // Grid in the keyfob's plane, just behind it: 5 mm minor, 1 cm major lines.
  var GRID = 40, gridZ = -THICK / 2 - 0.3;
  [[GRID * 2, '#e2d6c2'], [GRID, '#bba88a']].forEach(function (g) {
    var grid = new THREE.GridHelper(GRID, g[0], g[1], g[1]);
    grid.rotation.x = Math.PI / 2;
    grid.position.set(0, 1, gridZ);
    measures.add(grid);
  });

  var dimMat = new THREE.LineBasicMaterial({ color: '#3b2f24' });
  var labels = [];
  function segs(list) {
    var geo = new THREE.BufferGeometry().setFromPoints(list.map(function (p) { return new THREE.Vector3(p[0], p[1], 0); }));
    measures.add(new THREE.LineSegments(geo, dimMat));
  }
  function label(text, x, y) {
    var el = document.createElement('span');
    el.className = 'kf__dim';
    el.textContent = text;
    var obj = new CSS2DObject(el);
    obj.position.set(x, y, 0);
    obj.visible = false;
    labels.push(obj);
    measures.add(obj);
  }
  var T = 0.12;  // end tick half-length
  // width, under the keyfob
  var wy = -H / 2 - 0.8;
  segs([[-W / 2, wy], [W / 2, wy], [-W / 2, wy - T], [-W / 2, wy + T], [W / 2, wy - T], [W / 2, wy + T],
        [-W / 2, -H / 2 - 0.15], [-W / 2, wy - 0.2], [W / 2, -H / 2 - 0.15], [W / 2, wy - 0.2]]);
  label(mm(W), 0, wy);
  // height, to the right
  var hx = W / 2 + 0.8;
  segs([[hx, -H / 2], [hx, H / 2], [hx - T, -H / 2], [hx + T, -H / 2], [hx - T, H / 2], [hx + T, H / 2],
        [W / 2 + 0.15, -H / 2], [hx + 0.2, -H / 2], [W / 2 + 0.15, H / 2], [hx + 0.2, H / 2]]);
  label(mm(H), hx, 0);
  // hole, with a leader line out to the left
  var c45 = Math.SQRT1_2 * HOLE_R;
  segs([[-c45, HOLE_Y + c45], [-W / 2 - 0.5, HOLE_Y + 0.9], [-W / 2 - 0.5, HOLE_Y + 0.9], [-W / 2 - 1.1, HOLE_Y + 0.9]]);
  label('\u00d8 ' + mm(HOLE_R * 2), -W / 2 - 1.6, HOLE_Y + 0.9);

  var SPECS = { width: mm(W), height: mm(H), thickness: mm(THICK), hole: '\u00d8 ' + mm(HOLE_R * 2), spacing: mm(STITCH_PITCH), inset: mm(STITCH_INSET) };
  document.querySelectorAll('[data-spec]').forEach(function (dd) { dd.textContent = SPECS[dd.dataset.spec]; });

  document.getElementById('kfMeasure').addEventListener('click', function (ev) {
    var on = ev.currentTarget.getAttribute('aria-pressed') !== 'true';
    ev.currentTarget.setAttribute('aria-pressed', String(on));
    document.getElementById('kfSpecs').hidden = !on;
    measures.visible = on;
    // CSS2D labels ignore their parent's visibility, so switch them one by one
    labels.forEach(function (l) { l.visible = on; });
    lockBtn.hidden = !on;
    if (on) {
      faceFront();
    } else {
      setLock(false);
    }
  });

  // Face the keyfob straight on so the measurements read true.
  function faceFront() {
    controls.autoRotate = false;
    camera.position.set(0, 0.3, 22);
    controls.target.set(0, 0.3, 0);
    camera.up.set(0, 1, 0);
  }

  // Locked top view: no rotating; a drag (one finger on touch) moves the
  // image instead, and zoom goes in close enough to read the stitch spacing.
  var lockBtn = document.getElementById('kfLock');
  var hint = document.getElementById('kfHint');
  function setLock(on) {
    lockBtn.setAttribute('aria-pressed', String(on));
    controls.enableRotate = !on;
    controls.enablePan = on;
    controls.screenSpacePanning = true;
    controls.mouseButtons.LEFT = on ? THREE.MOUSE.PAN : THREE.MOUSE.ROTATE;
    controls.touches.ONE = on ? THREE.TOUCH.PAN : THREE.TOUCH.ROTATE;
    controls.minDistance = on ? 2 : 7;
    if (!on) { controls.target.set(0, 0.8, 0); }     // re-centre, panning is over
    hint.textContent = on ? hint.dataset.pan : hint.dataset.rotate;
    if (on) { faceFront(); }
  }
  lockBtn.addEventListener('click', function () {
    setLock(lockBtn.getAttribute('aria-pressed') !== 'true');
  });

  // ---------- fullscreen ----------
  var fullBtn = document.getElementById('kfFull');
  function fsElement() { return document.fullscreenElement || document.webkitFullscreenElement; }
  function setFull(on) {
    stage.classList.toggle('is-full', on);
    var label = on ? fullBtn.dataset.exit : fullBtn.dataset.enter;
    fullBtn.setAttribute('aria-label', label);
    fullBtn.title = label;
  }
  fullBtn.addEventListener('click', function () {
    var req = stage.requestFullscreen || stage.webkitRequestFullscreen;
    if (fsElement()) {
      (document.exitFullscreen || document.webkitExitFullscreen).call(document);
    } else if (stage.classList.contains('is-full')) {
      setFull(false);                       // leaving the fallback
    } else if (req) {
      req.call(stage);
    } else {
      setFull(true);                        // no Fullscreen API: fixed overlay
    }
  });
  ['fullscreenchange', 'webkitfullscreenchange'].forEach(function (ev) {
    document.addEventListener(ev, function () { setFull(fsElement() === stage); });
  });
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape' && stage.classList.contains('is-full') && !fsElement()) { setFull(false); }
  });

  // ---------- ui ----------
  document.querySelectorAll('.kf__opts[data-group]').forEach(function (grp) {
    grp.addEventListener('click', function (ev) {
      var btn = ev.target.closest('button');
      if (!btn) { return; }
      grp.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', String(x === btn)); });
      state[grp.dataset.group] = btn.dataset.value;
      // the shape is geometry; the rest is colour
      if (grp.dataset.group === 'shape') { build(); } else { applyColors(); }
    });
  });

  document.getElementById('kfText').addEventListener('input', function (ev) {
    state.text = ev.target.value;
    paintTextures();
  });

  // ---------- pattern PDF ----------
  // A 1:1 A4 template: print at 100%, cut, lay on the leather, and punch
  // through the marked slits. jsPDF and a font with Lithuanian letters
  // (DejaVu Sans) are only fetched on the first click.
  var I18N = JSON.parse(document.getElementById('kfI18n').textContent);
  var pdfReady = null;
  function loadPdf() {
    if (pdfReady) { return pdfReady; }
    var lib = new Promise(function (ok, fail) {
      var el = document.createElement('script');
      el.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
      el.onload = ok; el.onerror = fail;
      document.head.appendChild(el);
    });
    var font = fetch('https://cdn.jsdelivr.net/npm/dejavu-fonts-ttf@2.37.3/ttf/DejaVuSans.ttf')
      .then(function (r) { if (!r.ok) { throw new Error('font ' + r.status); } return r.arrayBuffer(); })
      .then(function (buf) {
        var bytes = new Uint8Array(buf), bin = '';
        for (var k = 0; k < bytes.length; k += 0x8000) { bin += String.fromCharCode.apply(null, bytes.subarray(k, k + 0x8000)); }
        return btoa(bin);
      });
    pdfReady = Promise.all([lib, font]).then(function (r) { return r[1]; });
    pdfReady.catch(function () { pdfReady = null; });   // let a later click retry
    return pdfReady;
  }

  function pressedLabel(group) {
    var b = document.querySelector('[data-group="' + group + '"] [aria-pressed="true"]');
    return b ? (b.getAttribute('aria-label') || b.textContent).trim() : '';
  }

  // Print calibration, asked for by the owner (2026-10-14). The pattern carries
  // two rulers: 200 mm across the foot of the sheet and 290 mm down its left
  // edge, drawn — like everything else that states a size — `cfx` and `cfy`
  // long. On the first print (fields at 20 and 29) the rulers are drawn at
  // their true length, so measuring them shows exactly what the printer does to
  // each axis. Type those two measurements in and the whole sheet is drawn
  // larger by the same percentages, so the next print comes out true size —
  // including the rulers, which then read 200 and 290 mm again. One factor per
  // axis because a printer need not squeeze both the same: this one takes 4%
  // off the width and 2.5% off the height.
  var calibX = document.getElementById('kfCalibX');
  var calibY = document.getElementById('kfCalibY');
  var calibNote = document.getElementById('kfCalibNote');
  function calibValue(input, nominal) {
    var v = parseFloat(input.value);
    return (v > nominal * 0.7 && v < nominal * 1.4) ? v : nominal;
  }
  function calibXf() { return 18 / calibValue(calibX, 18); }
  function calibYf() { return 27 / calibValue(calibY, 27); }
  function paintCalib() {
    calibNote.textContent = I18N.calib.hint + ' · × ' + calibXf().toFixed(3) + ' / × ' + calibYf().toFixed(3);
  }
  [['kfCalibX', calibX], ['kfCalibY', calibY]].forEach(function (pair) {
    try {
      var saved = window.localStorage.getItem(pair[0]);
      if (saved) { pair[1].value = saved; }
    } catch (err) { /* private mode: just do not remember it */ }
    function keep() {
      try { window.localStorage.setItem(pair[0], pair[1].value); } catch (err) {}
      paintCalib();
    }
    pair[1].addEventListener('input', keep);
    pair[1].addEventListener('change', keep);
  });

  function makePattern(fontB64) {
    var P = I18N.pattern, M = I18N.measure;
    var doc = new window.jspdf.jsPDF({ unit: 'mm', format: 'a4' });
    doc.addFileToVFS('DejaVuSans.ttf', fontB64);
    doc.addFont('DejaVuSans.ttf', 'DejaVu', 'normal');
    doc.setFont('DejaVu');
    doc.setLineCap('round');

    // shape cm -> page mm, y flipped; the keyfob sits left of centre, notes on
    // the right. `cfx`/`cfy` are the calibration: everything the sheet states a
    // size for is drawn that much larger, so the print comes out true size
    // whatever the printer did to the page. Both are 1 (the untouched file)
    // unless the owner has measured the two rulers and typed the lengths in.
    var cfx = calibXf(), cfy = calibYf();
    var OX = 62, OY = 150;
    function X(x) { return OX + x * 10 * cfx; }
    function Y(y) { return OY - y * 10 * cfy; }
    function poly(pts) {
      for (var k = 0; k < pts.length; k++) {
        var a = pts[k], b = pts[(k + 1) % pts.length];
        doc.line(X(a.x), Y(a.y), X(b.x), Y(b.y));
      }
    }

    // heading
    doc.setTextColor(40, 36, 31);
    doc.setFontSize(18); doc.text('SLOU — ' + P.title, 15, 20);
    doc.setFontSize(9); doc.setTextColor(110, 100, 90);
    doc.text(doc.splitTextToSize(P.print, 180), 15, 27);
    doc.text(doc.splitTextToSize(P.how, 180), 15, 36);

    // cut line + ring hole
    doc.setDrawColor(0); doc.setLineWidth(0.3);
    poly(outline(state.shape, 0).getPoints(48).filter(function (p, k, all) {
      return p.distanceTo(all[(k + 1) % all.length]) > 1e-4;
    }));
    doc.ellipse(X(0), Y(HOLE_Y), HOLE_R * 10 * cfx, HOLE_R * 10 * cfy);
    doc.setLineWidth(0.1);
    doc.line(X(0) - 1.5 * cfx, Y(HOLE_Y), X(0) + 1.5 * cfx, Y(HOLE_Y));
    doc.line(X(0), Y(HOLE_Y) - 1.5 * cfy, X(0), Y(HOLE_Y) + 1.5 * cfy);

    // stitch line, faint, then the slits exactly as the iron cuts them
    var holes = current.holes, chords = current.chords, n = holes.length, E = current.E;
    doc.setDrawColor(190); doc.setLineWidth(0.1);
    poly(holes);
    // Corner holes: pinned with an awl (dot), ringed, and showing the slit the
    // iron leaves there coming from each side (along the run in and the run out).
    doc.setDrawColor(0); doc.setFillColor(0);
    // slit centred on hole p, leaning off `dir`; h = half length (mm)
    function slitMark(p, dir, h, width) {
      var sl = slit(dir, 1);
      var hx = sl.x * h * cfx, hy = sl.y * h * cfy;
      doc.setLineWidth(width * (cfx + cfy) / 2);
      doc.line(X(p.x) - hx, Y(p.y) + hy, X(p.x) + hx, Y(p.y) - hy);
    }
    holes.forEach(function (p, k) {
      var cin = chords[(k + n - 1) % n], cout = chords[k];
      if (current.corner[k]) {
        // both slits only marked, not punched: grey with a black border
        // (black stroke, then a narrower grey one on top); the awl dot is
        // the only hole made here
        [cin, cout].forEach(function (d) { doc.setDrawColor(0); slitMark(p, d, 0.8, 0.45); });
        [cin, cout].forEach(function (d) { doc.setDrawColor(200); slitMark(p, d, 0.8, 0.25); });
        doc.setDrawColor(0);
        doc.ellipse(X(p.x), Y(p.y), 0.35 * cfx, 0.35 * cfy, 'F');
        doc.setLineWidth(0.15);
        doc.ellipse(X(p.x), Y(p.y), 1.3 * cfx, 1.3 * cfy);
        return;
      }
      // drawn longer than the cut (1.6 mm) so it's easy to see and punch on
      slitMark(p, cin.clone().add(cout).normalize(), 0.8, 0.45);
    });

    // thread joint: bracket beside the doubled stitches, outside the piece
    var a = holes[E], b = holes[(E + OVERLAP) % n];
    doc.setDrawColor(180, 40, 30); doc.setLineWidth(0.4);
    var off = X(-W / 2) - 6;   // left of the keyfob
    doc.line(off, Y(a.y), off, Y(b.y));
    doc.line(off, Y(a.y), off + 2, Y(a.y));
    doc.line(off, Y(b.y), off + 2, Y(b.y));

    // initials as a stamping guide
    var L = textLayout();
    if (L) {
      doc.setTextColor(150);
      doc.setFontSize(L.size * 10 * cfy * 72 / 25.4);
      doc.text(L.txt, X(L.x), Y(L.y), { align: 'center', baseline: 'middle', angle: L.vertical ? 90 : 0 });
    }

    // legend + specs on the right
    var lx = 118, ly = 70;
    doc.setFontSize(9); doc.setTextColor(40, 36, 31);
    function key(draw, label) {
      var lines = doc.splitTextToSize(label, 195 - lx - 12);
      draw(lx, ly - 1); doc.text(lines, lx + 12, ly); ly += 3 + 4 * lines.length;
    }
    key(function (x, y) { doc.setDrawColor(0); doc.setLineWidth(0.3); doc.line(x, y, x + 8, y); }, P.cut);
    key(function (x, y) { doc.setDrawColor(0); doc.setLineWidth(0.45); doc.line(x + 3.4, y - 0.6, x + 4.6, y + 0.6); }, P.holes);
    key(function (x, y) {
      [[0, 0.45], [200, 0.25]].forEach(function (st) {
        doc.setDrawColor(st[0]); doc.setLineWidth(st[1]);
        doc.line(x + 3.4, y - 0.6, x + 4.6, y + 0.6); doc.line(x + 3.4, y + 0.6, x + 4.6, y - 0.6);
      });
      doc.setDrawColor(0);
      doc.setFillColor(0); doc.circle(x + 4, y, 0.35, 'F');
      doc.setLineWidth(0.15); doc.circle(x + 4, y, 1.3);
    }, P.corner);
    key(function (x, y) { doc.setDrawColor(180, 40, 30); doc.setLineWidth(0.4); doc.line(x + 3, y - 2, x + 3, y + 2); }, P.joint);
    key(function (x, y) { doc.setDrawColor(0); doc.setLineWidth(0.3); doc.circle(x + 4, y, 2); }, P.ring + ' Ø ' + mm(HOLE_R * 2));

    ly += 4;
    var rows = [
      [M.width + ' × ' + M.height, mm(W) + ' × ' + mm(H)],
      [M.thickness, mm(THICK)],
      [M.spacing, mm(STITCH_PITCH)],
      [M.inset, mm(STITCH_INSET)],
      [P.stitches, String(n)],
      [P.leather, pressedLabel('leather')],
      [P.thread, pressedLabel('thread')],
    ];
    if (L) { rows.push([P.initials, L.txt]); }
    rows.forEach(function (r) {
      doc.setTextColor(110, 100, 90); doc.text(r[0], lx, ly);
      doc.setTextColor(40, 36, 31); doc.text(r[1], 195, ly, { align: 'right' });
      ly += 6;
    });

    // Calibration rulers, asked for by the owner (2026-10-14). Two of them, one
    // per axis, and each centred on the sheet along its own direction — the
    // vertical one an equal distance from the top and the bottom edge, the
    // horizontal one an equal distance from the left and the right; the
    // horizontal also sits 5 cm up from the bottom. Centring is what he asked
    // for after a print came out crooked and the top of the vertical ruler was
    // lost in the printer's margin: a line centred on the page keeps its ends
    // well inside whatever the machine does with registration.
    //
    // Both are drawn `cfx`/`cfy` long like everything else that states a size.
    // On the first print (fields at their defaults) they are their true length
    // and show what the printer does to each axis; once the owner has typed the
    // two measurements in, they print 270 and 180 mm again and the whole sheet
    // is true size. Those lengths are what A4 leaves once the correction has
    // enlarged them (the clamps are only a backstop for an extreme printer).
    var calNomV = 270, calNomH = 180;
    var calLenV = Math.min(calNomV * cfy, 292);
    var calVx = 10;                                  // 1 cm in from the left
    var calVy = (297 - calLenV) / 2;                 // equal from top and bottom
    var calLenH = Math.min(calNomH * cfx, 198);
    var calHx = (210 - calLenH) / 2;                 // equal from left and right
    var calHy = 297 - 40;                            // 4 cm up from the bottom
    doc.setDrawColor(0); doc.setLineWidth(0.2);
    doc.line(calVx, calVy, calVx, calVy + calLenV);
    doc.line(calVx - 3, calVy, calVx + 3, calVy);
    doc.line(calVx - 3, calVy + calLenV, calVx + 3, calVy + calLenV);
    doc.line(calHx, calHy, calHx + calLenH, calHy);
    doc.line(calHx, calHy - 3, calHx, calHy + 3);
    doc.line(calHx + calLenH, calHy - 3, calHx + calLenH, calHy + 3);
    doc.setTextColor(40, 36, 31); doc.setFontSize(7);
    doc.text(calNomV + ' mm', calVx + 5, calVy + calLenV - 3);
    doc.text(calNomH + ' mm', calHx, calHy - 5);
    doc.text(doc.splitTextToSize(P.calibNote, 175), calVx + 6, calHy + 9);   // clear of the vertical ruler

    // And a 5 × 5 cm square in the bottom right corner, 1 cm above the
    // horizontal ruler (2026-10-14): a short measurement in both directions at
    // once, for anyone who would rather trust a square than a line. Drawn
    // `cfx` by `cfy` so it comes out a true 50 × 50 mm, and its right edge kept
    // 15 mm clear of the page edge.
    var sqNom = 50, sqR = 195, sqB = calHy - 10;
    var sqW = sqNom * cfx, sqH = sqNom * cfy;
    doc.setDrawColor(0); doc.setLineWidth(0.2);
    doc.rect(sqR - sqW, sqB - sqH, sqW, sqH);
    doc.setTextColor(40, 36, 31); doc.setFontSize(7);
    doc.text(sqNom + ' mm', sqR - sqW / 2, sqB + 4, { align: 'center' });

    doc.save('slou-keyfob-pattern-' + state.shape + '.pdf');
  }

  document.getElementById('kfPattern').addEventListener('click', function (ev) {
    var btn = ev.currentTarget, label = btn.textContent;
    btn.disabled = true; btn.textContent = I18N.pattern.loading;
    loadPdf().then(makePattern).catch(function (err) { console.error(err); }).then(function () {
      btn.disabled = false; btn.textContent = label;
    });
  });

  document.getElementById('kfShot').addEventListener('click', function () {
    renderer.render(scene, camera);
    var a = document.createElement('a');
    a.download = 'slou-keyfob.png';
    a.href = renderer.domElement.toDataURL('image/png');
    a.click();
  });

  function resize() {
    var w = stage.clientWidth, h = stage.clientHeight;
    renderer.setSize(w, h, false);
    labelRenderer.setSize(w, h);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  new ResizeObserver(resize).observe(stage);

  paintCalib();
  build();
  applyColors();
  resize();
  renderer.setAnimationLoop(function () {
    controls.update();
    renderer.render(scene, camera);
    labelRenderer.render(scene, camera);
  });
</script>

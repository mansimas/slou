<article class="page page--wide">
  <p class="kicker">SLOU</p>
  <h1>Užsakymai</h1>
  <p>Visi per pagrindinio puslapio užsakymų langą pateikti užsakymai, įrašyti į <code>logs/orders.log</code>. Iš viso: <strong><%= orders.total %></strong>.</p>

  <% if (orders.total === 0) { %>
    <p style="margin-top:22px;color:var(--muted);">Kol kas nėra nė vieno įrašo.</p>
  <% } else { %>
    <div class="orders-scroll">
      <table class="orders">
        <thead>
          <tr>
            <th>#</th>
            <th>Data</th>
            <th>Vardas</th>
            <th>El. paštas</th>
            <th>Žinutė</th>
            <th>Kalba</th>
          </tr>
        </thead>
        <tbody>
          <%
            /* Numeravimas nuo naujausio: rows jau surikiuotas naujausi
               pirmi, todėl #1 yra paskutinis užsakymas. */
          %>
          <% orders.rows.forEach(function (o, i) { %>
            <tr>
              <td><%= (orders.page * orders.per_page) + i + 1 %></td>
              <td class="nowrap"><%= o.when %></td>
              <td><%= o.name %></td>
              <td><a class="inline" href="mailto:<%= o.email %>"><%= o.email %></a></td>
              <td class="msg"><%= o.message %></td>
              <td><%= o.locale %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</article>

<style>
  /* Šis puslapis platesnis nei įprastas .page (780px), kad lentelė tilptų. */
  .page--wide { max-width: 1140px; }
  .orders-scroll { overflow-x: auto; margin-top: 26px; border: 1px solid var(--line); border-radius: 10px; }
  table.orders { width: 100%; border-collapse: collapse; font-size: 14px; background: var(--card); }
  table.orders th, table.orders td { padding: 11px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  table.orders thead th { background: var(--paper-2); font-weight: 600; letter-spacing: .3px; text-transform: uppercase; font-size: 12px; color: var(--muted); white-space: nowrap; }
  table.orders tbody tr:last-child td { border-bottom: none; }
  table.orders tbody tr:hover { background: rgba(166,121,74,.06); }
  table.orders td.nowrap { white-space: nowrap; }
  /* Viena eilutė — vienas užsakymas. Žinutė nelaužoma į kitą eilutę: ilga
     žinutė praplečia lentelę ir ji slenkama į šoną. */
  table.orders th, table.orders td { white-space: nowrap; }
  table.orders td.msg { white-space: nowrap; }

  /*
    Telefone lentelė LIEKA lentele — anksčiau ji virsdavo kortelėmis, kur vienas
    užsakymas užimdavo septynias eilutes. Dabar tik mažesnis šriftas ir tarpai,
    o platesnis turinys slenkamas į šoną.
  */
  @media (max-width: 720px) {
    table.orders { font-size: 12.5px; }
    table.orders th, table.orders td { padding: 7px 9px; }
  }
</style>

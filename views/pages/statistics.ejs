<%
/**
 * statistics.ejs
 *
 * Lankytojai ir užsakymai pagal dieną, savaitę ir mėnesį. Skaičiuojama iš
 * logs/requests.log ir logs/orders.log (žr. api/services/StatsService.js).
 *
 * Kaip ir užsakymų puslapis, šis yra tik savininkui, todėl lietuviškai ir
 * neverčiamas į kitas kalbas.
 */
%>
<article class="page page--wide">
  <p class="kicker">SLOU</p>
  <h1>Statistika</h1>

  <p>
    <strong>Apsilankymai</strong> — puslapių užklausos be botų ir be šio bei
    užsakymų puslapio. <strong>Unikalūs</strong> — skirtingi lankytojai
    (pagal <code>vid</code> slapuką). <strong>Botai</strong> — paieškos
    sistemų robotai, rodomi atskirai, kad neišpūstų apsilankymų.
  </p>

  <div class="stat-totals">
    <div class="stat-card">
      <span class="stat-card__n"><%= stats.totals.visits %></span>
      <span class="stat-card__l">Apsilankymai (viso)</span>
    </div>
    <div class="stat-card">
      <span class="stat-card__n"><%= stats.totals.orders %></span>
      <span class="stat-card__l">Užsakymai (viso)</span>
    </div>
    <div class="stat-card">
      <span class="stat-card__n"><%= stats.totals.bots %></span>
      <span class="stat-card__l">Botų užklausos (viso)</span>
    </div>
  </div>

  <%
    /* Trys vienodos lentelės — viena funkcija, kad eilutė būtų apibrėžta
       vienoje vietoje ir visos trys negalėtų išsiskirti. */
  %>
  <% function table(title, rows, empty) { %>
    <h2 class="stat-h"><%= title %></h2>
    <% if (!rows.length) { %>
      <p class="stat-empty"><%= empty %></p>
    <% } else { %>
      <div class="orders-scroll">
        <table class="orders stats">
          <thead>
            <tr>
              <th>Laikotarpis</th>
              <th>Apsilankymai</th>
              <th>Unikalūs</th>
              <th>Botai</th>
              <th>Užsakymai</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function (r) { %>
              <tr>
                <td class="nowrap"><%= r.label %></td>
                <td><%= r.visits %></td>
                <td><%= r.unique %></td>
                <td class="muted"><%= r.bots %></td>
                <td><%= r.orders ? r.orders : '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  <% } %>

  <% table('Pagal dieną', stats.days, 'Kol kas nėra duomenų.') %>
  <% table('Pagal savaitę', stats.weeks, 'Kol kas nėra duomenų.') %>
  <% table('Pagal mėnesį', stats.months, 'Kol kas nėra duomenų.') %>

</article>

<style>
  .page--wide { max-width: 1140px; }

  .stat-totals { display: flex; flex-wrap: wrap; gap: 14px; margin: 26px 0 8px; }
  .stat-card { flex: 1 1 180px; padding: 18px 20px; background: var(--card);
    border: 1px solid var(--line); border-radius: 10px; }
  .stat-card__n { display: block; font-family: var(--serif); font-size: 30px; line-height: 1.1; color: var(--leather-dark); }
  .stat-card__l { display: block; margin-top: 4px; font-size: 12px; letter-spacing: .4px;
    text-transform: uppercase; color: var(--muted); }

  .stat-h { font-family: var(--serif); font-weight: 500; font-size: 24px; margin: 34px 0 0; }
  .stat-empty { margin-top: 12px; color: var(--muted); }

  /* Bendra su užsakymų lentele: rėmelis, antraštės, mobilios kortelės. */
  .orders-scroll { overflow-x: auto; margin-top: 14px; border: 1px solid var(--line); border-radius: 10px; }
  table.orders { width: 100%; border-collapse: collapse; font-size: 14px; background: var(--card); }
  table.orders th, table.orders td { padding: 10px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  table.orders thead th { background: var(--paper-2); font-weight: 600; letter-spacing: .3px; text-transform: uppercase; font-size: 12px; color: var(--muted); white-space: nowrap; }
  table.orders tbody tr:last-child td { border-bottom: none; }
  table.orders tbody tr:hover { background: rgba(166,121,74,.06); }
  table.orders td.muted { color: var(--muted); }
  /* Viena eilutė — vienas laikotarpis, niekas nelaužoma į kitą eilutę. */
  table.orders th, table.orders td { white-space: nowrap; }

  /*
    Telefone lentelė LIEKA lentele — anksčiau virsdavo kortelėmis, kur viena
    diena užimdavo penkias eilutes. Dabar tik mažesnis šriftas ir tarpai, o
    platesnis turinys slenkamas į šoną.
  */
  @media (max-width: 720px) {
    table.orders { font-size: 12.5px; }
    table.orders th, table.orders td { padding: 7px 9px; }
    .stat-card__n { font-size: 26px; }
  }
</style>

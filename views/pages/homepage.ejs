<%
/**
 * homepage.ejs
 *
 * The title lives in the shared head bar (views/layouts/slou.ejs), so the
 * page itself starts with the product video row (the main event), then the
 * order box. The full catalogue lives
 * on the individual product pages rather than being repeated here. There is
 * no footer — the layout ends with the page content.
 */
%>
<div class="wrap">

  <%
    /* The visitor's own conversation with the shop. Empty and hidden in the
       HTML: the server does not know who is looking (no login, no session),
       only the browser does — it holds the conversation's key in localStorage
       from the order it placed. The script in layouts/slou.ejs fetches the
       thread with that key and fills this in, so it sits at the very top for
       anyone coming back to read the reply, and stays hidden for everyone
       else. */
  %>
  <section class="convbox" id="conv" hidden
           data-you="<%= t.conversation.you %>"
           data-shop="<%= t.conversation.shop %>"
           data-waiting="<%= t.conversation.waiting %>"
           data-send="<%= t.conversation.send %>"
           data-sending="<%= t.conversation.sending %>"
           data-error="<%= t.conversation.error %>"
           data-empty="<%= t.conversation.empty %>"
           data-locale="<%= t.htmlLang %>">
    <h2><%= t.conversation.title %></h2>
    <p class="convbox__lead"><%= t.conversation.lead %></p>
    <ol class="convlog" id="convLog" aria-live="polite"></ol>
    <form id="convForm" novalidate>
      <div class="field">
        <label for="cMsg" class="sr-only"><%= t.conversation.placeholder %></label>
        <textarea id="cMsg" name="message" maxlength="4000" required
                  aria-describedby="cMsgErr"
                  placeholder="<%= t.conversation.placeholder %>"></textarea>
        <p class="field-err" id="cMsgErr" hidden></p>
      </div>
      <button type="submit" class="btn solid" id="cSubmit"><%= t.conversation.send %></button>
    </form>
  </section>

  <%- include('../partials/video-row', { featured: featured, t: t }) %>

  <section class="orderbox" id="order">
    <h2><%= t.order.title %></h2>
    <p class="orderbox__lead"><%= t.order.lead %></p>

    <%
      /* `novalidate` turns OFF the browser's own validation on purpose. Left
         on, the browser blocks submission and shows its bubble before our
         handler ever runs — in the BROWSER's language, which on this site is
         routinely not the language the visitor chose. The checks below replace
         it with the same rules in `t`'s language.

         `required` and `pattern` stay on the fields anyway: they still
         describe the field to assistive technology, and they are what the
         validation would fall back to if this attribute were ever removed. */
    %>
    <form id="orderForm" novalidate
          data-send="<%= t.order.send %>"
          data-sending="<%= t.order.sending %>"
          data-ok="<%= t.order.ok %>"
          data-error="<%= t.order.error %>"
          data-err-name="<%= t.order.errName %>"
          data-err-email="<%= t.order.errEmail %>"
          data-err-details="<%= t.order.errDetails %>">
      <div class="order-who">
        <div class="field">
          <label for="oName"><%= t.order.name %></label>
          <input id="oName" name="name" type="text" maxlength="120" required
                 aria-describedby="oNameErr">
          <p class="field-err" id="oNameErr" hidden></p>
        </div>
        <div class="field">
          <label for="oEmail"><%= t.order.email %></label>
          <input id="oEmail" name="email" type="email" pattern="[^@\s]+@[^@\s]+\.[A-Za-z]{2,}"
                 aria-describedby="oEmailHint oEmailErr">
          <p class="field-hint" id="oEmailHint"><%= t.order.emailHint %></p>
          <p class="field-err" id="oEmailErr" hidden></p>
        </div>
      </div>
      <div class="field">
        <label for="oMsg"><%= t.order.details %></label>
        <textarea id="oMsg" name="message" maxlength="4000" required
                  aria-describedby="oMsgErr"
                  placeholder="<%= t.order.placeholder %>"></textarea>
        <p class="field-err" id="oMsgErr" hidden></p>
      </div>
      <button type="submit" class="btn solid" id="oSubmit"><%= t.order.send %></button>
      <div class="form-note" id="oNote" hidden></div>
    </form>
  </section>


</div>
